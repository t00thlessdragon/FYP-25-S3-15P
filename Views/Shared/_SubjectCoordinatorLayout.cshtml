@* Views/Shared/_SubjectCoordinatorLayout.cshtml *@
@{
    Layout = null;

    var currentAction     = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");

    Func<string, string> isActiveByAction = a =>
        currentAction.Equals(a, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    Func<string, string, string> isActive = (ctrl, act) =>
        (currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
        && currentAction.Equals(act, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] SMART – Subject Coordinator</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- NAV -->
    <nav class="navbar navbar-expand-lg navbar-light bg-nav fixed-top shadow-sm">
      <div class="container-wide nav-grid">

        <!-- Brand (link to SC Dashboard) -->
        <a class="navbar-brand p-0 me-3"
           asp-controller="SubjectCoordinator" asp-action="Dashboard">
          <img src="~/images/smartlogo.png" alt="SMART" class="brand-logo" />
        </a>

        <!-- Toggler (mobile) -->
        <button class="navbar-toggler d-lg-none ms-auto" type="button"
                data-bs-toggle="collapse" data-bs-target="#scNav"
                aria-controls="scNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- CENTER (desktop): Subject Coordinator tabs -->
        <ul class="navbar-nav nav-center d-none d-lg-flex">
          <li class="nav-item">
            <a class="nav-link @isActive("SubjectCoordinator","Dashboard")"
               asp-controller="SubjectCoordinator" asp-action="Dashboard">
               Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link @isActive("SubjectCoordinator","Projects")"
               asp-controller="SubjectCoordinator" asp-action="Projects">
               Manage Project
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link @isActive("SubjectCoordinator","Templates")"
               asp-controller="SubjectCoordinator" asp-action="Templates">
               Manage Project Templates
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link @isActive("SubjectCoordinator","Allocation")"
               asp-controller="SubjectCoordinator" asp-action="Allocation">
               Manage Project Allocation
            </a>
          </li>
        </ul>

        <!-- RIGHT (desktop): user dropdown -->
        <div class="d-none d-lg-flex align-items-center ms-3">
          @if (User?.Identity?.IsAuthenticated ?? false)
          {
              var displayName = User.Identity?.Name ?? "Subject Coordinator";
              <div class="dropdown">
                <a class="nav-link dropdown-toggle fw-semibold" href="#" role="button"
                   data-bs-toggle="dropdown" aria-expanded="false">
                  Welcome, @displayName
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <a class="dropdown-item"
                       asp-controller="SubjectCoordinator" asp-action="Profile">Profile</a>
                  </li>
                  <li><a class="dropdown-item" href="mailto:support@smart.local">Contact Support</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                      @Html.AntiForgeryToken()
                      <button type="submit" class="btn btn-link text-danger p-0">
                        <i class="bi bi-power"></i> Logout
                      </button>
                    </form>
                  </li>
                </ul>
              </div>
          }
        </div>

        <!-- MOBILE collapse -->
        <div class="collapse d-lg-none mt-2" id="scNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link @isActiveByAction("Dashboard")"
                 asp-controller="SubjectCoordinator" asp-action="Dashboard">Dashboard</a>
            </li>
            <li class="nav-item">
              <a class="nav-link @isActiveByAction("Projects")"
                 asp-controller="SubjectCoordinator" asp-action="Projects">Manage Project</a>
            </li>
            <li class="nav-item">
              <a class="nav-link @isActiveByAction("Templates")"
                 asp-controller="SubjectCoordinator" asp-action="Templates">Manage Project Templates</a>
            </li>
            <li class="nav-item">
              <a class="nav-link @isActiveByAction("Allocation")"
                 asp-controller="SubjectCoordinator" asp-action="Allocation">Manage Project Allocation</a>
            </li>

            @if (User?.Identity?.IsAuthenticated ?? false)
            {
              <li><hr class="dropdown-divider" /></li>
              <li class="nav-item px-2 text-muted">Welcome, @User.Identity!.Name</li>
              <li class="nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 my-2">
                  @Html.AntiForgeryToken()
                  <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-power"></i> Logout
                  </button>
                </form>
              </li>
            }
          </ul>
        </div>

      </div>
    </nav>

    <!-- push content below fixed nav -->
    <main class="pt-nav">
        @RenderBody()
    </main>

    <script src="~/js/choices.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
