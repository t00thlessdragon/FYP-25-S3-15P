       <div class="text-muted" style="min-width:140px;">${ids[i] || ''}</div>
       <div>${r.dataset.title || ''}</div>
     </div>`).join('');
  preview.innerHTML = items;
}


  // events
  selectAll.addEventListener('change', e => {
    tbody.querySelectorAll('.cp-row').forEach(cb => cb.checked = e.target.checked);
    refreshPreview();
  });

  tbody.addEventListener('change', e => {
    if (!e.target.classList.contains('cp-row')) return;
