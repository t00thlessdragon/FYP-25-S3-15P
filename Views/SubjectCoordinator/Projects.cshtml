<script>
(() => {
  const modal = new bootstrap.Modal(document.getElementById('constraintViewModal'));

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.js-view-constraint');
    if (!btn) return;

    const program = btn.dataset.program || '';
    const year   = btn.dataset.year || '';

    try {
      const url = '@Url.Action("GetConstraintDetails","SubjectCoordinator")' + `?programCode=${encodeURIComponent(program)}&year=${encodeURIComponent(year)}`;
      const res = await fetch(url, { headers: { 'Accept': 'application/json' }});
      if (!res.ok) throw new Error(await res.text());
      const d = await res.json();

      document.getElementById('vc-code').textContent     = program;
      document.getElementById('vc-name').textContent     = btn.dataset.name || '-';
      document.getElementById('vc-session').textContent  = d.sessionNo ? `S1–S${d.sessionNo}` : '-';
      document.getElementById('vc-year').textContent     = year;

      document.getElementById('vc-default').checked  = (d.status?.toLowerCase() !== 'override');
      document.getElementById('vc-override').checked = (d.status?.toLowerCase() === 'override');

      document.getElementById('vc-sup').textContent      = d.sup ?? '—';
      document.getElementById('vc-ass').textContent      = d.ass ?? '—';
      document.getElementById('vc-rank').textContent     = d.rank ?? '—';
      document.getElementById('vc-team-min').textContent = d.teamMin ?? '—';
      document.getElementById('vc-team-max').textContent = d.teamMax ?? '—';

      modal.show();
    } catch (err) {
      alert('Failed to load constraints: ' + (err?.message || err));
    }
  });
})();
</script>

