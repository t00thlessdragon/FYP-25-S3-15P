      const url = '@Url.Action("PreviewProjectIds","SubjectCoordinator")'
                + `?program=${encodeURIComponent(prog)}`
                + `&year=${encodeURIComponent(yearVal)}`
                + `&session=${encodeURIComponent(sessionVal)}`
                + `&count=${rows.length}`;
      const res = await fetch(url, { headers: { 'Accept':'application/json' }});
      if (res.ok) {
        const d = await res.json();
        ids = Array.isArray(d.ids) ? d.ids : [];
      }
    } catch {}
  }

  // fallback if preview endpoint not available / invalid selections
  if (!ids.length){
    const two = n => n.toString().padStart(2,'0');
