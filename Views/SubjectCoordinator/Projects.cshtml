let page = 1, pageSize = 10, total = 0;

async function load(){
  const url = '@Url.Action("GetProjectTemplates","SubjectCoordinator")'
    + `?programme=${encodeURIComponent(programme.value)}`
    @* + `&course=${encodeURIComponent(course.value)}` *@
    + `&year=${encodeURIComponent(yearSel.value)}`
    + `&session=${encodeURIComponent(sessionSel.value)}`
    @* + `&module=${encodeURIComponent(moduleSel.value)}` *@
    + `&q=${encodeURIComponent(qBox.value)}`
    + `&page=${page}&pageSize=${pageSize}`;

  const res = await fetch(url, { headers: { 'Accept': 'application/json' }});
  if (!res.ok){
    tbody.innerHTML = `<tr><td colspan="6" class="text-danger">Failed to load templates</td></tr>`;
    return;
  }

  const data = await res.json();
  total = data.total || 0;

  if (!data.items?.length) {
    tbody.innerHTML = `<tr><td colspan="6" class="text-muted">No templates found.</td></tr>`;
  } else {
    renderRows(data.items);
  }

  renderPagination();
  selectAll.checked = false;
  refreshPreview();
}

