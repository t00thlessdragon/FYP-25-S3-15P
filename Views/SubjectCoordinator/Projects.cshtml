  document.getElementById('editProjectModal').addEventListener('shown.bs.modal', fillProgramDropdown);

  // Keep selected MODULE CODES here
  let selected = new Set();

  // Render a chip (label can be code or "CODE Name"; value = CODE)
  function addChip(label, code) {
    if (!code || selected.has(code)) return;
    selected.add(code);

    const chip = document.createElement('span');
    chip.className = 'badge rounded-pill bg-secondary-subtle text-dark border px-3 py-2 d-inline-flex align-items-center';
    chip.dataset.code = code;
    chip.innerHTML = `<span class="me-2">${label}</span><button type="button" class="btn btn-sm btn-link p-0 text-muted ms-1 ep-chip-x">X</button>`;
    chipbar.appendChild(chip);
  }

  function clearChips() {
    selected.clear();
    chipbar.innerHTML = '';
  }
@* 

  moduleSel.addEventListener('change', () => {
    const val = moduleSel.value;
    if (!val || val === 'Module') { moduleSel.selectedIndex = 0; return; }

    const code  = val.split(' ')[0].trim();        // CODE
    const label = val.trim();                      // display
    addChip(label, code);
    moduleSel.selectedIndex = 0;
  }); *@

  // Remove chip
  chipbar.addEventListener('click', (e) => {
    const x = e.target.closest('.ep-chip-x');
    if (!x) return;
    const chip = x.closest('[data-code]');
    const code = chip?.dataset.code;
    if (code) selected.delete(code);
    chip?.remove();
  });

  // Open modal on Edit
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.js-edit-project');
    if (!btn) return;
    idEl.textContent = btn.dataset.id || '';
    titleEl.value    = btn.dataset.title || '';
    progEl.innerHTML = btn.dataset.programme || 'IT';
    descEl.value     = btn.dataset.desc || '';
    clearChips();
    const codes = (btn.dataset.modcodes || '')
                    .split('|')
                    .map(s => s.trim())
                    .filter(Boolean);

    // Show chips as CODE labels
    codes.forEach(code => addChip(code, code));

    modal.show();
  });

  saveBtn.addEventListener('click', async () => {
    const payload = {
      id:        idEl.textContent.trim(),
      title:     titleEl.value.trim(),
      programme: progEl.value,
      modules:   Array.from(selected), // list of CODES
      desc:      descEl.value.trim()
    };

    try {
      const res = await fetch('@Url.Action("EditProject","SubjectCoordinator")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
