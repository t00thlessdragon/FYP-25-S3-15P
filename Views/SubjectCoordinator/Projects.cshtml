@model FYP_25_S3_15P.ViewModels.ScProjectsPageVm

@{
    Layout = "~/Views/Shared/_SubjectCoordinatorLayout.cshtml";
    ViewData["Title"] = "Manage";
    var tab = (Context.Request.Query["tab"].ToString() ?? ViewBag.ActiveTab ?? "").ToLowerInvariant();
    if (string.IsNullOrWhiteSpace(tab)) tab = "constraints";
}


<section class="container-wide card-xl">
  <div class="card rounded-4 p-4 p-lg-5 shadow-lg">

    <h2 class="mb-1">Manage Projects</h2>
    <div class="text-muted mb-4">Manage Constraints, Projects, and Groups</div>

    <!-- Tabs (same pattern as Student Dashboard) -->
    <ul class="nav nav-tabs mb-4" role="tablist">
      <li class="nav-item">
        <a class="nav-link @(tab=="constraints" ? "active" : "")"
           asp-action="Projects" asp-route-tab="constraints">
          Manage Constraints
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link @(tab=="projects" ? "active" : "")"
           asp-action="Projects" asp-route-tab="projects">
          Manage Projects
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link @(tab=="groups" ? "active" : "")"
           asp-action="Projects" asp-route-tab="groups">
          Manage Groups
        </a>
      </li>
    </ul>

    <div class="tab-content">

     <!-- ===== TAB: CONSTRAINTS ===== -->
<div class="tab-pane fade @(tab=="constraints" ? "show active" : "")" id="tab-constraints">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Project Constraints</h4>
    <div class="d-flex gap-2">
      <a href="javascript:void(0)" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#constraintAddModal">
  <i class="bi bi-plus-lg me-1"></i> Add & Update
</a>

      <button class="btn btn-outline-danger" id="btn-delete-constraints">
  <i class="bi bi-trash me-1"></i> Delete
</button>

    </div>
  </div>

  <!-- Filters (kept consistent with Projects) -->
<form class="row g-2 align-items-center mb-3" id="fc-form">
  <div class="col-12 col-lg-3">
    <select class="form-select" id="fc-year">
      <option value="__all__">Year: All</option>
      <option value="@Model.Year" selected>Year: @Model.Year</option>
    </select>
  </div>
  <div class="col-12 col-lg-3">
    <select class="form-select" id="fc-program">
      <option value="__all__" selected>Program: All</option>
      <!-- JS will add distinct course codes found in the table -->
    </select>
  </div>
  <div class="col-12 col-lg-3">
    <select class="form-select" id="fc-session">
      <option value="__all__" selected>Session: All</option>
      <option value="S1">Session: S1</option>
      <option value="S2">Session: S2</option>
      <option value="S3">Session: S3</option>
      <option value="S4">Session: S4</option>
    </select>
  </div>
  <div class="col-12 col-lg-3">
    <div class="input-group">
      <input class="form-control" id="fc-search" placeholder="Search…" />
      <button class="btn btn-dark" type="button" id="fc-search-btn">
        <i class="bi bi-search"></i>
      </button>
    </div>
  </div>
</form>


  <!-- TABLE (same look as Manage Projects) -->
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle w-100">
      <thead class="table-dark">
        <tr>
          <th style="width:4%; text-align:center;">
            <input type="checkbox" id="selectAllConstraints" />
          </th>
          <th style="width:12%;">Program Code</th>
          <th>Program Name</th>
          <th style="width:10%;">Session</th>
          <th style="width:12%;">Status</th>
          <th style="width:14%;">Last Updated</th>
          <th class="actions-col text-end">Action</th>
        </tr>
      </thead>
      <tbody>
@foreach (var r in Model.Constraints)
{
    var statusClass = (r.Status ?? "").ToLower() == "override" ? "text-bg-primary" : "text-bg-secondary";
    <tr data-code="@r.Code" data-name="@r.Name">
        <td class="text-center"><input type="checkbox" class="rowCheckbox-constraints" /></td>
        <td class="fw-semibold">@r.Code</td>
        <td class="text-muted">@r.Name</td>
        <td>@r.Session</td>
        <td><span class="badge rounded-pill @statusClass">@r.Status</span></td>
        <td>@(r.Updated == DateTime.MinValue ? "-" : r.Updated.ToString("dd MMM yyyy"))</td>
        <td class="text-end actions-cell">
            <span class="actions-wrap">
                <button class="btn btn-dark btn-sm px-3 js-view-constraint"
                        data-program="@r.Code" data-name="@r.Name" data-year="@Model.Year">
                  View
                </button>
            </span>
        </td>
    </tr>
}
</tbody>

    </table>
  </div>
</div>

<!-- Constraint Details Modal -->
<div class="modal fade" id="constraintViewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 rounded-4">
      <div class="modal-header border-0 pb-0">
        <h3 class="modal-title fw-bold">Project Constraints</h3>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body pt-2">
        <!-- Top details -->
        <div class="row g-2 mb-3">
          <div class="col-12"><div><strong>Program Code:</strong> <span id="vc-code">—</span></div></div>
          <div class="col-12"><div><strong>Program Name:</strong> <span id="vc-name">—</span></div></div>
          <div class="col-12 col-md-6"><div><strong>Session:</strong> <span id="vc-session">—</span></div></div>
          <div class="col-12 col-md-6"><div><strong>Year:</strong> <span id="vc-year">—</span></div></div>
        </div>

        <!-- Status + Edit -->
        <div class="d-flex align-items-center gap-3 mb-4">
          <div class="fw-semibold">Status:</div>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="vc-default" disabled>
            <label class="form-check-label" for="vc-default">Default</label>
          </div>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="vc-override" disabled>
            <label class="form-check-label" for="vc-override">Override</label>
          </div>
        </div>

        <!-- Constraints table -->
        <div class="table-responsive">
          <table class="table table-bordered vc-constraints-table">
            <thead>
              <tr>
                <th class="w-50">Constraints</th>
                <th class="w-50 text-center">Setting</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Supervisor Load Cap</td>
                <td class="text-center" id="vc-sup">—</td>
              </tr>
              <tr>
                <td>Assessor Load Cap</td>
                <td class="text-center" id="vc-ass">—</td>
              </tr>
              <tr>
                <td>Preferences Rank Limit</td>
                <td class="text-center" id="vc-rank">—</td>
              </tr>
              <tr>
                <td>Team Size Per Project</td>
                <td class="text-center">
                  Min: <span id="vc-team-min">—</span>
                  &nbsp;&nbsp; Max: <span id="vc-team-max">—</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Add Constraint Modal -->
<div class="modal fade" id="constraintAddModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 rounded-4">
      <div class="modal-header border-0 pb-0">
        <h3 class="modal-title fw-bold">Project Constraints</h3>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body pt-2">
        <!-- Top form -->
        <!-- Top form -->
<div class="row g-3 mb-3">
  <div class="col-12">
    <label class="form-label fw-semibold">Program Code:</label>
    <select id="ap-code" class="form-select">
      <!-- JS will repopulate; placeholder keeps it empty initially -->
      <option value="" selected disabled>— Select course —</option>
    </select>
    <div class="invalid-feedback" id="ap-code-error">Course Code is required.</div>
  </div>

  <div class="col-12">
    <label class="form-label fw-semibold">Program Name:</label>
    <input id="ac-name" class="form-control" placeholder="Auto show name after choose code" disabled />
  </div>

  <div class="col-12 col-md-6">
    <label class="form-label fw-semibold">Session:</label>
    <select id="ac-session" class="form-select">
      <option value="" selected disabled>— Select session —</option>
    </select>
    <div class="invalid-feedback" id="ac-session-error">Session is required.</div>
  </div>

  <div class="col-12 col-md-6">
    <label class="form-label fw-semibold">Year:</label>
    <select id="ac-year" class="form-select">
      <option value="" selected disabled>— Select year —</option>
    </select>
    <div class="invalid-feedback" id="ac-year-error">Year is required.</div>
  </div>
</div>

<!-- Status -->
<div class="d-flex align-items-center gap-3 mb-4">
  <div class="fw-semibold">Status:</div>
  <div class="form-check form-check-inline">
    <input class="form-check-input" type="checkbox" id="ac-default" checked>
    <label class="form-check-label" for="ac-default">Default</label>
  </div>
  <div class="form-check form-check-inline">
    <input class="form-check-input" type="checkbox" id="ac-override">
    <label class="form-check-label" for="ac-override">Override</label>
  </div>
</div>


        <!-- Constraints table -->
        <div class="table-responsive">
          <table class="table table-bordered vc-constraints-table">
            <thead>
              <tr>
                <th class="w-50">Constraints</th>
                <th class="w-50 text-center">Setting</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Supervisor Load Cap</td>
                <td class="text-center">
                  <input id="ac-sup" class="form-control text-center mx-auto" style="max-width:120px" value="1" disabled>
                </td>
              </tr>
              <tr>
                <td>Assessor Load Cap</td>
                <td class="text-center">
                  <input id="ac-ass" class="form-control text-center mx-auto" style="max-width:120px" value="2" disabled>
                </td>
              </tr>
              <tr>
                <td>Preferences Rank Limit</td>
                <td class="text-center">
                  <input id="ac-rank" class="form-control text-center mx-auto" style="max-width:120px" value="3" disabled>
                </td>
              </tr>
              <tr>
                <td>Team Size Per Project</td>
                <td class="text-center">
                  <div class="d-flex justify-content-center gap-3">
                    <div>Min: <input id="ac-team-min" class="form-control d-inline-block text-center" style="width:90px" value="4" disabled></div>
                    <div>Max: <input id="ac-team-max" class="form-control d-inline-block text-center" style="width:90px" value="6" disabled></div>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Bottom-right corner single button -->
<div class="text-end mt-3">
  <button type="button" class="btn btn-dark px-4" id="ac-edit-toggle">Save</button>
</div>


      </div>
    </div>
  </div>
</div>



 <!-- ===== TAB: PROJECTS (final wireframe style) ===== -->
<div class="tab-pane fade @(tab=="projects" ? "show active" : "")" id="tab-projects">

  <!-- Title + buttons same row -->
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0 fw-bold">Project Listings</h4>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-dark" id="btn-publish-projects">Publish</button>
      <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#createProjectModal">
  <i class="bi bi-plus-lg me-1"></i> Project
</button>

      <button type="button" class="btn btn-outline-danger" id="btn-delete-projects">
  <i class="bi bi-trash me-1"></i> Delete
</button>

    </div>
  </div>

  <!-- Filters row -->
<form class="row g-2 align-items-center mb-3" id="pj-filter-form">
  <div class="col-12 col-md-3">
    <select class="form-select" id="pj-program">
      <option value="__all__" selected>Program: All</option>
      <!-- JS will populate from Project ID prefix (e.g., IT-FND) -->
    </select>
  </div>

  @* <div class="col-12 col-md-3">
    <select class="form-select" id="pj-module">
      <option value="__all__" selected>Module: All</option>
      <!-- JS will populate from the Module column -->
    </select>
  </div> *@

  <div class="col-12 col-md-3">
    <select class="form-select" id="pj-session">
      <option value="__all__" selected>Session: All</option>
      <option value="S1">Session: S1</option>
      <option value="S2">Session: S2</option>
      <option value="S3">Session: S3</option>
      <option value="S4">Session: S4</option>
    </select>
  </div>

  <div class="col-12 col-md-3">
    <div class="input-group">
      <input class="form-control" id="pj-search" placeholder="Search by ID / Title / Programme" />
      <button class="btn btn-dark" type="button" id="pj-search-btn">
        <i class="bi bi-search"></i>
      </button>
    </div>
  </div>
</form>


  <!-- Table -->
  <div class="table-responsive">
    <table class="table table-hover align-middle w-100">
      <thead class="table-dark">
        <tr>
          <th style="width:50px" class="text-center"><input type="checkbox"  id="pj-select-all"/></th>
          <th style="width:160px">Project ID</th>
          <th>Project Title</th>
          <th>Description</th>
          <th style="width:120px">Programme</th>
          <th style="width:120px">Publish Status</th>
          @* <th style="width:320px">Module</th> *@
          <th style="width:160px" class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var p in Model.Projects)
{
    <tr data-id="@p.Id">
        <td class="text-center"><input type="checkbox"/></td>
        <td class="text-muted"><span class="small">@p.Id</span></td>
        <td class="fw-semibold">@p.Title</td>
        <td>@p.Description</td>
        <td>@p.Programme</td>
        <td>@p.IsPublish</td>
        @* <td>
            @foreach (var m in p.Modules)
            {
                <div class="text-muted">@m</div>
            }
        </td> *@
        <td class="text-end">
            <div class="d-inline-flex gap-2">
                <button type="button"
                        class="btn btn-dark btn-sm px-4 js-view-project"
                        data-id="@p.Id"
                        data-title="@p.Title"
                        data-programme="@p.Programme"
                        @* data-modules='@string.Join(", ", p.Modules)' *@
                        data-desc="@p.Description">
                    View
                </button>
                <button type="button"
                        class="btn btn-dark btn-sm px-4 js-edit-project"
                        data-id="@p.Id"
                        data-title="@p.Title"
                        data-programme="@p.Programme"
                        @* data-modcodes='@string.Join("|", p.ModuleCodes)' *@
                        data-desc='@p.Description'>
                    Edit
                </button>
            </div>
        </td>
    </tr>
}

      </tbody>
    </table>
  </div>
</div>

<!-- Create Project Modal -->
<div class="modal fade" id="createProjectModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content border-0 rounded-4">
      <div class="modal-header border-0">
        <h3 class="modal-title fw-bold">Create Project</h3>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">

        <div class="row g-3 mb-3">
  <div class="col-12 col-md-3">
    <label class="form-label small text-muted">Programme:</label>
    <select id="cp-programme" class="form-select"></select>
    <div class="invalid-feedback" id="cp-programme-error">Please choose a programme.</div>
  </div>

  @* <div class="col-12 col-md-3">
    <label class="form-label small text-muted">Course:</label>
    <select id="cp-course" class="form-select"></select>
    <div class="invalid-feedback" id="cp-course-error">Please choose a course.</div>
  </div> *@

  <div class="col-6 col-md-3">
    <label class="form-label small text-muted">Year:</label>
    <select id="cp-year" class="form-select"></select>
  </div>

  <div class="col-6 col-md-3">
    <label class="form-label small text-muted">Session:</label>
    <select id="cp-session" class="form-select"></select>
  </div>
</div>


<!-- Preferences close at -->
<div class="row g-3 mb-3">
  <div class="col-12">
    <div class="fw-semibold small text-muted">
      Student &amp; Supervisor Preferences (Closed At)
    </div>
  </div>

  <div class="col-6 col-md-3">
    <label class="form-label small text-muted">Date:</label>
    <input type="date" id="cp-pref-date" class="form-control" />
    <div class="invalid-feedback" id="cp-pref-date-err">Please choose a date.</div>
  </div>

  <div class="col-6 col-md-3">
    <label class="form-label small text-muted">Time:</label>
    <input type="time" id="cp-pref-time" class="form-control" step="60" />
    <div class="invalid-feedback" id="cp-pref-time-err">Please choose a time.</div>
  </div>
</div>


        <!-- Module filter + search -->
        <div class="row g-3 mb-2 align-items-center">
          @* <div class="col-12 col-md-4">
            <div class="input-group">
              <select id="cp-module" class="form-select border-start-0">
                <option value="">All modules</option>
                <option>AI301 Machine Learning</option>
                <option>DATA201 Data Mining</option>
                <option>CS321 Web Engineering</option>
                <option>SEC210 Network Security</option>
              </select>
            </div>
          </div> *@
          <div class="col-12 col-md-8">
            <div class="input-group">
              <input id="cp-search" class="form-control" placeholder="Search" />
              <button type="button" class="btn btn-dark" id="cp-search-btn"><i class="bi bi-search"></i></button>
            </div>
          </div>
        </div>

        <!-- Templates table -->
        <div class="table-responsive mt-2">
          <table class="table align-middle">
            <thead class="table-dark">
              <tr>
                <th style="width:4%; text-align:center;"><input type="checkbox" id="cp-select-all" /></th>
                <th style="width:12%;">Template ID</th>
                <th>Project Title</th>
                <th style="width:10%;">Programme</th>
                @* <th style="width:28%;">Module</th> *@
                <th style="width:10%;">Status</th>
              </tr>
            </thead>
            <tbody id="cp-tbody">
            </tbody>
          </table>
        </div>

        <!-- Pagination hint (mock) -->
        <div class="small text-muted mb-3">Pagination: <a href="javascript:void(0)">[1]</a> <a href="javascript:void(0)">[2]</a> <a href="javascript:void(0)">[3]</a> <a href="javascript:void(0)">[4]</a></div>

        <!-- Preview -->
        <div class="mb-2 fw-semibold">Preview of Projects to Create:</div>
        <div id="cp-preview" class="border rounded-3 p-3 small bg-light">
          <div class="text-muted">No templates selected.</div>
        </div>


      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-dark btn-lg" id="cp-create">Create Project</button>
      </div>
    </div>
  </div>
</div>

<!-- Project Details Modal -->
<div class="modal fade" id="projectDetailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content border-0 rounded-4">
