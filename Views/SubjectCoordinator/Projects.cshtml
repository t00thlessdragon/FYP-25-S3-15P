<script>
(() => {
  const tbody      = document.querySelector('#tab-projects tbody');
  if (!tbody) return;

  const programSel  = document.getElementById('pj-program');
  //const moduleSel  = document.getElementById('pj-module');
  const sessionSel = document.getElementById('pj-session');
  const qBox       = document.getElementById('pj-search');
  const qBtn       = document.getElementById('pj-search-btn');

  const rows = () => Array.from(tbody.querySelectorAll('tr'));
  const norm = s => (s || '').toString().trim().toLowerCase();

  // Helpers to read row fields
  function getId(r)       { return (r.querySelector('td:nth-child(2) span')?.textContent || '').trim(); }
  function getTitle(r)    { return (r.querySelector('td:nth-child(3)')?.textContent || '').trim(); }
  function getProgramme(r){ return (r.querySelector('td:nth-child(4)')?.textContent || '').trim(); }
  function getModules(r)  {
    return Array.from(r.querySelectorAll('td:nth-child(5) .text-muted')).map(d => d.textContent.trim());
  }

  function getCourseFromId(id) {
    // match first two hyphen-delimited segments
    const m = id.match(/^([A-Za-z0-9]+-[A-Za-z0-9]+)/);
    return m ? m[1] : '';
  }
  // Session (S1/S2/S3) extracted from ProjectId
  function getSessionFromId(id) {
    const m = id.match(/-(S\d)-/i);
    return m ? m[1].toUpperCase() : '';
  }

  // Populate filter dropdowns from table
  (function populateFilters(){
    const courseSet = new Set();
    const moduleSet = new Set();

    rows().forEach(r => {
      const id  = getId(r);
      const crs = getCourseFromId(id);
      if (crs) courseSet.add(crs);

      getModules(r).forEach(m => { if (m) moduleSet.add(m); });
    });

    // Courses
    courseSet.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c; opt.textContent = `Program: ${c}`;
      programSel.appendChild(opt);
    });

    // Modules
    @* moduleSet.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m; opt.textContent = m;
      moduleSel.appendChild(opt);
    }); *@
  })();

  function applyFilter() {
    const cVal = programSel?.value || '__all__';
    @* const mVal = moduleSel?.value || '__all__'; *@
    const sVal = sessionSel?.value || '__all__';
    const q    = norm(qBox?.value);

    rows().forEach(r => {
      const id        = getId(r);
      const title     = getTitle(r);
      const programme = getProgramme(r);
      const modules   = getModules(r);

      const rowCourse  = getCourseFromId(id).toUpperCase();
      const rowSession = getSessionFromId(id).toUpperCase();

      const okCourse  = (cVal === '__all__') || rowCourse === cVal.toUpperCase();
      @* const okModule  = (mVal === '__all__') || modules.some(x => x.toLowerCase() === mVal.toLowerCase()); *@
      const okSession = (sVal === '__all__') || rowSession === sVal.toUpperCase();

      const hay = `${id} ${title} ${programme} ${modules.join(' ')}`;
      const okSearch = !q || norm(hay).includes(q);

      r.style.display = (okCourse && okSession && okSearch) ? '' : 'none';
    });
  }

  // Wire events
  programSel.addEventListener('change', applyFilter);
  @* moduleSel.addEventListener('change', applyFilter); *@
  sessionSel.addEventListener('change', applyFilter);
  qBtn.addEventListener('click', applyFilter);
  qBox.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); applyFilter(); } });

  // Initial pass
  applyFilter();
})();
</script>
