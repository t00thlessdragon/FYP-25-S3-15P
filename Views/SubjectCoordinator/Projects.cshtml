  if (selectAll && tbody) {
    selectAll.addEventListener('change', e => {
      tbody.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = e.target.checked);
    });
  }

  // Delete button handler
  const delBtn = document.getElementById('btn-delete-projects');
  if (!delBtn || !tbody) return;

  // Adjust to your real controller action name if different
  const deleteUrl = '@Url.Action("DeleteProjects","SubjectCoordinator")';

  function selectedRows() {
