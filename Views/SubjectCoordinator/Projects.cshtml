        onHidden: () => window.location.reload()
      });
    } catch (err) {
      await showNotify({ title: 'Save failed', text: err?.message || 'Network error' });
    }
  });
})();
</script>



<script>
(() => {
  const tbody   = document.querySelector('#tab-projects tbody');
  const pubBtn  = document.querySelector('button.btn.btn-dark'); 
  if (!tbody || !pubBtn) return;

  function selectedIds(){
    return Array.from(tbody.querySelectorAll('tr'))
      .filter(r => r.querySelector('input[type="checkbox"]')?.checked)
      .map(r => r.dataset.id)
      .filter(Boolean);
  }

  pubBtn.addEventListener('click', async () => {
    const ids = selectedIds();
    if (!ids.length) { await showNotify({title:'No selection', text:'Select at least one project.'}); return; }

    const ok = await showConfirm({
      title: `Publish ${ids.length} project${ids.length>1?'s':''}?`,
      text:  'They will appear for students and supervisors to submit preferences.',
      okText:'Publish', cancelText:'Cancel'
    });
    if (!ok) return;

    try {
      const res = await fetch('@Url.Action("PublishProjects","SubjectCoordinator")', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ ids })
      });
      if (!res.ok) {
        const t = await res.text();
        await showNotify({ title:'Publish failed', text: t || 'Server error.' });
        return;
      }
      const d = await res.json();
      await showNotify({
        title:'Published',
        text: `Published ${d.published} project(s).`,
        onHidden: () => window.location.reload()
      });
    } catch (err) {
      await showNotify({ title:'Publish failed', text: err?.message || 'Network error.' });
    }
  });
})();
</script>

