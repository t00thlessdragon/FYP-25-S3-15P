async function checkCourseConstraintExists(programCode, year, session) {
  try {
    const url = '@Url.Action("GetConstraintDetails","SubjectCoordinator")'
              + `?programCode=${encodeURIComponent(programCode)}&year=${encodeURIComponent(year)}`;
    const res = await fetch(url, { headers: { 'Accept': 'application/json' }});

    if (!res.ok) {
      return { ok:false, reason:'missing' };
    }

    const d = await res.json();               
    const maxSession = Number(d.sessionNo) || 0;

    if (maxSession && session > maxSession) { 
      return { ok:false, reason:'session', maxSession };
    }

    return { ok:true, maxSession };
  } catch {
    return { ok:false, reason:'network' };
  }
}

