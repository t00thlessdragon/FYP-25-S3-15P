  async function fillProgramDropdown() {
  @* const sel = document.getElementById('ep-module');
  const res = await fetch('@Url.Action("GetAllModules","SubjectCoordinator")', { headers: { 'Accept':'application/json' }});
  if (!res.ok) return;
