<script>
(() => {
  // ------- elements
  const tbody     = document.querySelector('#tab-constraints tbody');
  if (!tbody) return;

  const yearSel   = document.getElementById('fc-year');
  const programSel = document.getElementById('fc-program');
  const sessSel   = document.getElementById('fc-session');
  const qBox      = document.getElementById('fc-search');
  const qBtn      = document.getElementById('fc-search-btn');

  // ------- helpers
  const rows = () => Array.from(tbody.querySelectorAll('tr'));
  const norm = s => (s || '').toString().trim().toLowerCase();

  // Build the course list from table
  (function populateCoursesFromTable(){
    const seen = new Set();
    rows().forEach(r => {
      const code = (r.dataset.code || '').trim();
      if (code && !seen.has(code)) {
        seen.add(code);
        const opt = document.createElement('option');
        opt.value = code;
        opt.textContent = `Program: ${code}`;
        programSel.appendChild(opt);
      }
    });
  })();

  function getSessionText(r){
    const cell = r.children[3];
    return cell ? cell.textContent.trim() : '';
  }

  // Main filter
  function applyFilter(){
    const yVal  = yearSel?.value || '__all__';         
    const cVal  = programSel?.value || '__all__';
    const sVal  = sessSel?.value || '__all__';
    const query = norm(qBox?.value);

    rows().forEach(r => {
      const code = (r.dataset.code || '');
      const name = (r.dataset.name || '');
      const sessionText = getSessionText(r); // e.g. "S1–S3"

      // matchers
      const okCourse  = (cVal === '__all__') || code.toUpperCase() === cVal.toUpperCase();
      const okSession = (sVal === '__all__') || sessionText.includes(sVal); 
      const okSearch  = !query || (norm(code).includes(query) || norm(name).includes(query));

      const show = okCourse && okSession && okSearch; 
      r.style.display = show ? '' : 'none';
    });
  }

  // Wire events
  programSel.addEventListener('change', applyFilter);
  sessSel.addEventListener('change', applyFilter);
  yearSel.addEventListener('change', applyFilter); 
  qBtn.addEventListener('click', applyFilter);
  qBox.addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); applyFilter(); }
  });

  applyFilter();
})();
</script>

<script>
(() => {
