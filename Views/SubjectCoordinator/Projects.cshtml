    setInvalid(course, courseErr, true);
    hasError = true;
  } *@


// Date + Time are required
if (!prefDate.value) { setInvalid(prefDate, prefDateErr, true); hasError = true; }
if (!prefTime.value) { setInvalid(prefTime, prefTimeErr, true); hasError = true; }

  if (hasError) return;

  const rows = rowCheckedRows();
  if (!rows.length){
    await showNotify({ title: 'No templates selected', text: 'Please tick at least one template.' });
    return;
  }

  const payload = {
    programme: programme.value,
    @* course: course.value, *@
    year: parseInt(yearSel.value, 10),
    session: parseInt((sessionSel.value || 'S1').replace(/[^0-9]/g,''), 10) || 1,
    templateIds: rows.map(r => r.dataset.templateId)
  };

 payload.prefCloseAt = `${prefDate.value}T${prefTime.value}:00`;


 const chk = await checkCourseConstraintExists(payload.programme, payload.year, payload.session);
  if (!chk.ok) {
    let msg = 'Please set the course constraint first in the "Manage Constraints" tab.';
    if (chk.reason === 'session') {
      msg = `Constraints are defined only up to S${chk.maxSession}. `
          + `Please add constraints for session S${payload.session}.`;
    } else if (chk.reason === 'network') {
      msg = 'Could not verify constraints due to a network error. Please try again.';
    }
    await showNotify({
      title: 'Constraints required',
      text:  msg,
      onHidden: () => window.location = '@Url.Action("Projects","SubjectCoordinator")?tab=constraints'
    });
    return; 
  }


  const res = await fetch('@Url.Action("CreateProjectsFromTemplates","SubjectCoordinator")', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });

  if (!res.ok){
    const t = await res.text();
    await showNotify({ title: 'Create failed', text: t || 'Server error' });
    return;
  }

  const d = await res.json();
  bootstrap.Modal.getInstance(dlg)?.hide();
  await showNotify({
    title: 'Created',
    text:  `Created ${d.created} project(s): ${ (d.projectIds||[]).join(', ') }`,
    onHidden: () => window.location.reload()
  });
});


  // reset + initial load each time it opens
  dlg.addEventListener('shown.bs.modal', () => {
    selectAll.checked = false;
    qBox.value = '';
    @* moduleSel.value = ''; *@
    page = 1;
    load();
  });
})();
</script>


<script>
(() => {
  const dlg = document.getElementById('constraintAddModal');
  if (!dlg) return;

  const codeSel = dlg.querySelector('#ap-code');
  const nameBox = dlg.querySelector('#ac-name');
  const sessSel = dlg.querySelector('#ac-session');
  const yearSel = dlg.querySelector('#ac-year');
  const defCb   = dlg.querySelector('#ac-default');
  const ovCb    = dlg.querySelector('#ac-override');

  const supBox  = dlg.querySelector('#ac-sup');
  const assBox  = dlg.querySelector('#ac-ass');
  const rankBox = dlg.querySelector('#ac-rank');
  const teamMin = dlg.querySelector('#ac-team-min');
  const teamMax = dlg.querySelector('#ac-team-max');

  const saveBtn = dlg.querySelector('#ac-edit-toggle');

  // Inline error helpers
  const errors = {
    code: dlg.querySelector('#ap-code-error'),
    sess: dlg.querySelector('#ac-session-error'),
    year: dlg.querySelector('#ac-year-error')
  };

  function setInvalid(el, msgEl, invalid) {
    if (invalid) {
      el.classList.add('is-invalid');
      msgEl.style.display = '';
    } else {
      el.classList.remove('is-invalid');
      msgEl.style.display = 'none';
    }
  }

  function validateRequired() {
    const a = !codeSel.value;
    const b = !sessSel.value;
    const c = !yearSel.value;

    setInvalid(codeSel, errors.code, a);
    setInvalid(sessSel, errors.sess, b);
    setInvalid(yearSel, errors.year, c);

    return !(a || b || c);
  }

  // Enable constraints only when Override is checked
  function refreshConstraintsEnabled() {
    const allow = ovCb.checked;
    [supBox, assBox, rankBox, teamMin, teamMax].forEach(el => el.disabled = !allow);
  }

  // Build year select with placeholder (so it's "empty" initially)
  function buildYears(years = [2024, 2025, 2026]) {
    yearSel.innerHTML =
      `<option value="" selected disabled>— Select year —</option>` +
      years.map(y => `<option value="${y}">${y}</option>`).join('');
  }

  // Data loads
  @* async function loadCourses() {
    const res  = await fetch('@Url.Action("GetCourses","SubjectCoordinator")');
    const rows = await res.json();
    codeSel.innerHTML =
      `<option value="" selected disabled>— Select course —</option>` +
      rows.map(r => `<option value="${r.code}" data-name="${r.name}">${r.code}</option>`).join('');
    nameBox.value = '';
  } *@

  async function loadProgram() {
    const res  = await fetch('@Url.Action("GetProgram","SubjectCoordinator")');
    const rows = await res.json();
    codeSel.innerHTML =
      `<option value="" selected disabled>— Select course —</option>` +
      rows.map(r => `<option value="${r.code}" data-name="${r.name}">${r.code}</option>`).join('');
    nameBox.value = '';
  }

async function loadScaffold() {
  if (!yearSel.value) return;

  const y = parseInt(yearSel.value, 10);
  const res = await fetch('@Url.Action("GetConstraintScaffold","SubjectCoordinator")' + `?year=${y}`);
  if (!res.ok) {
    console.error('Scaffold HTTP error', res.status, await res.text());
    return;
  }

  const d = await res.json();

  const toNum = (v, fb) => {
    const n = Number(v);
    return Number.isFinite(n) ? n : fb;
  };

  // sessions
  const sessionNo = toNum(d.sessionNo, 3);
  sessSel.innerHTML =
    `<option value="" selected disabled>— Select session —</option>` +
    Array.from({ length: sessionNo }, (_, i) => `<option value="${i+1}">S${i+1}</option>`).join('');

  // values from DB
  supBox.value  = toNum(d.sLoadCap, 1);
  assBox.value  = toNum(d.aLoadCap, 2);
  rankBox.value = toNum(d.prefRankLimit, 3);
  teamMin.value = toNum(d.sMin, 4);
  teamMax.value = toNum(d.sMax, 6);

  // status toggles
  defCb.checked = true;
  ovCb.checked  = false;

  refreshConstraintsEnabled();

  // clear validation styling
  [codeSel, sessSel, yearSel].forEach(el =>
    setInvalid(el, errors[el.id.split('-')[1]] ?? { style: {} }, false)
  );
}




  async function resetForNext() {
  buildYears();
  await loadProgram();

  // Preselect current year from server and pull defaults immediately
  const defaultYear = '@Model.Year';        // e.g., 2025
  if (defaultYear) {
    yearSel.value = String(defaultYear);
    await loadScaffold();                   
  } else {
    // if no server year, keep session blank
    sessSel.innerHTML = `<option value="" selected disabled>— Select session —</option>`;
  }

  // Clear any validation styles and set enable/disable state
  [codeSel, sessSel, yearSel].forEach(el => setInvalid(el, errors[el.id.split('-')[1]] ?? {style:{}}, false));
  refreshConstraintsEnabled();
}

  // Events
  codeSel.addEventListener('change', () => {
    const opt = codeSel.options[codeSel.selectedIndex];
    nameBox.value = opt?.dataset?.name || '';
    setInvalid(codeSel, errors.code, !codeSel.value);
  });

  yearSel.addEventListener('change', async () => {
    setInvalid(yearSel, errors.year, !yearSel.value);
    await loadScaffold();
  });

  sessSel.addEventListener('change', () => setInvalid(sessSel, errors.sess, !sessSel.value));

  defCb.addEventListener('change', () => { if (defCb.checked) ovCb.checked = false; refreshConstraintsEnabled(); });
  ovCb.addEventListener('change',  () => { if (ovCb.checked) defCb.checked = false; refreshConstraintsEnabled(); });

  // SAVE
  // SAVE
saveBtn.addEventListener('click', async () => {
  if (!validateRequired()) return;

  const ok = await showConfirm({
    title: 'Save these constraints?',
    text:  'This will create/update the course constraint for the selected year and session.',
    okText: 'OK',
    cancelText: 'Cancel'
  });
  if (!ok) return;

  const payload = {
    programCode:    codeSel.value,
    year:          parseInt(yearSel.value, 10),
    sessionNo:     parseInt(sessSel.value, 10),
    isOverride:    ovCb.checked,
    sLoadCap:      parseInt(supBox.value, 10),
    aLoadCap:      parseInt(assBox.value, 10),
    prefRankLimit: parseInt(rankBox.value, 10),
    sMin:          parseInt(teamMin.value, 10),
    sMax:          parseInt(teamMax.value, 10)
  };

  const res = await fetch('@Url.Action("SaveProgramConstraint","SubjectCoordinator")', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });

  if (!res.ok) {
    const t = await res.text();
    await showNotify({ title: 'Save failed', text: t });
    return;
  }

  // Auto-close the Add Constraint form, then show success popup
  const addDlg = document.getElementById('constraintAddModal');
  bootstrap.Modal.getInstance(addDlg)?.hide();

  // optional: refresh the grid in the background
  await resetForNext();

  await showNotify({
    title: 'Constraint saved',
    text:  'Your course constraint has been saved successfully.',
    onHidden: () => window.location.reload()
  });

  // Optionally force a reload of the grid behind:
  // window.location = '@Url.Action("Projects","SubjectCoordinator")?tab=constraints';
});


  // Fresh form every time modal opens
  dlg.addEventListener('shown.bs.modal', resetForNext);
})();
</script>

<script>
  function showConfirm({ title, text, okText = 'OK', cancelText = 'Cancel' } = {}) {
    return new Promise(resolve => {
      const el    = document.getElementById('confirmModal');
      const m     = new bootstrap.Modal(el);
      const ttl   = document.getElementById('confirmModalTitle');
      const body  = document.getElementById('confirmModalText');
      const okBtn = document.getElementById('confirmOkBtn');
      const cancelBtn = document.getElementById('confirmCancelBtn');

      ttl.textContent  = title || 'Are you sure?';
      body.textContent = text  || 'Please confirm this action.';
      okBtn.textContent = okText;
      cancelBtn.textContent = cancelText;

      let settled = false;

      okBtn.onclick = () => { settled = true; m.hide(); resolve(true); };
      el.addEventListener('hidden.bs.modal', () => { if (!settled) resolve(false); }, { once: true });

      m.show();
    });
  }

  async function showNotify({ title, text, onHidden } = {}) {
    const el   = document.getElementById('notifyModal');
    const m    = new bootstrap.Modal(el);
    document.getElementById('notifyTitle').textContent = title || 'Done';
    document.getElementById('notifyText').textContent  = text  || '';
    if (onHidden) el.addEventListener('hidden.bs.modal', onHidden, { once: true });
    m.show();
  }
</script>
