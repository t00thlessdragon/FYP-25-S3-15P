  titleInput.insertAdjacentElement('afterend', titleErr);

  let timer;
  async function runCheck(){
    const idVal = (idInput.value || '').trim().toUpperCase();
    const titleVal = (titleInput.value || '').trim();
    if (!idVal && !titleVal) { idErr.textContent=''; titleErr.textContent=''; saveBtn.disabled=false; return; }

    try{
      const res = await fetch(`/SubjectCoordinator/CheckTemplateExists?id=${encodeURIComponent(idVal)}&title=${encodeURIComponent(titleVal)}`);
      if (!res.ok) return;
      const data = await res.json();
      idErr.textContent    = data.idExists ? '⚠️ This Template ID already exists.' : '';
      titleErr.textContent = data.titleExists ? '⚠️ This Title already exists.' : '';
      saveBtn.disabled = !!(data.idExists || data.titleExists);
    }catch{ /* ignore */ }
  }
  function debounced(){ clearTimeout(timer); timer = setTimeout(runCheck, 350); }

  idInput.addEventListener('input', e => { e.target.value = e.target.value.toUpperCase(); debounced(); });
  titleInput.addEventListener('input', debounced);

  // Extra: enforce all fields before submit (modules included)
  document.getElementById('tplCreateForm').addEventListener('submit', (ev) => {
    const id = idInput.value.trim();
    const title = titleInput.value.trim();
    const desc = document.getElementById('c-desc').value.trim();
    const modulesCsv = document.getElementById('c-modules').value.trim(); // chips write codes here
    const ok = id && title && desc && modulesCsv; // programme & status are selects, always have value
    if (!ok || saveBtn.disabled){
      ev.preventDefault();
      // highlight basics
      idInput.classList.toggle('is-invalid', !id);
      titleInput.classList.toggle('is-invalid', !title);
      document.getElementById('c-desc').classList.toggle('is-invalid', !desc);
      
    }
  });
})();
</script>

<script>
/* ===== Edit / Create modal wiring (chips + open + submit) ===== */
(() => {
  // ---------- helpers ----------
  function parseModulesFromData(attr) {
    try { const a = JSON.parse(attr || '[]'); return Array.isArray(a) ? a : []; }
    catch { return (attr || '').split(/[|,]/).map(s => s.trim()).filter(Boolean); }
  }
  function labelForCode(code) {
    const opt = document.querySelector(`#c-module-picker option[value="${code}"]`)
             || document.querySelector(`#e-module-picker option[value="${code}"]`);
    return opt ? opt.textContent : code;
  }
  function renderChips(chipsBox, hiddenInput, codes) {
    chipsBox.innerHTML = '';
    codes.forEach(code => {
      const badge = document.createElement('span');
      badge.className = 'badge rounded-pill bg-secondary-subtle text-dark border px-3 py-2 me-2 mb-2';
      badge.innerHTML = `${labelForCode(code)} <button type="button" class="btn-close ms-1" data-value="${code}" aria-label="Remove" style="opacity:.6;"></button>`;
      chipsBox.appendChild(badge);
    });
    hiddenInput.value = codes.join('|');
  }

  function setModuleValidity(prefix, isValid){
  const picker = document.getElementById(`${prefix}-module-picker`);
  const chips  = document.getElementById(`${prefix}-module-chips`);
  const err    = document.getElementById(`${prefix}-module-error`);
  if (isValid){
    picker.classList.remove('is-invalid');
    err?.classList.add('d-none');
    chips?.classList.remove('invalid');
  }else{
    picker.classList.add('is-invalid');
    err?.classList.remove('d-none');
    chips?.classList.add('invalid');
  }
}

function currentModules(prefix){
  return (document.getElementById(`${prefix}-modules`).value || '')
         .split('|').filter(Boolean);
}

  function attachChipPicker(picker, chipsBox, hiddenInput, onChanged) {
  picker?.addEventListener('change', () => {
    const v = picker.value;
    if (!v) return; // first disabled option
    const cur = (hiddenInput.value || '').split('|').filter(Boolean);
    if (!cur.includes(v)) cur.push(v);
    renderChips(chipsBox, hiddenInput, cur);
    picker.value = ''; // back to placeholder
    onChanged?.(cur);
  });

  chipsBox?.addEventListener('click', (e) => {
    const btn = e.target.closest('.btn-close');
    if (!btn) return;
    const v = btn.getAttribute('data-value');
    const cur = (hiddenInput.value || '').split('|').filter(Boolean).filter(x => x !== v);
    renderChips(chipsBox, hiddenInput, cur);
    onChanged?.(cur);
  });
}

  function getToken(formEl) {
    const el = formEl.querySelector('input[name="__RequestVerificationToken"]')
           || document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
  }
  async function postForm(url, token, fields, moduleCodes) {
    const body = new URLSearchParams();
    Object.entries(fields).forEach(([k,v]) => body.append(k, v ?? ''));
    (moduleCodes || []).forEach(c => body.append('Modules', c)); // sends repeated Modules=... values
    if (token) body.append('__RequestVerificationToken', token);
    const res = await fetch(url, { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body });
    if (!res.ok) throw new Error(await res.text());
    return res;
  }

  // ---------- chip pickers (both modals) ----------
  attachChipPicker(
    document.getElementById('e-module-picker'),
    document.getElementById('e-module-chips'),
    document.getElementById('e-modules'),
    (cur) => setModuleValidity('e', cur.length > 0)
  );
  attachChipPicker(
    document.getElementById('c-module-picker'),
    document.getElementById('c-module-chips'),
    document.getElementById('c-modules'),
    (cur) => setModuleValidity('c', cur.length > 0)

  );

  // ---------- open EDIT modal + populate ----------
  const editModalEl = document.getElementById('tplEditModal');
  const editModal   = new bootstrap.Modal(editModalEl);

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.js-edit-template');
    if (!btn) return;

    const upId = (btn.dataset.id || '').toUpperCase();
    document.getElementById('e-id').value           = upId;
    document.getElementById('e-id-txt').textContent = upId;
    document.getElementById('e-title').value        = btn.dataset.title || '';
    document.getElementById('e-programme').value    = btn.dataset.programme || '';
    document.getElementById('e-status').value       = btn.dataset.status || 'Active';
    document.getElementById('e-desc').value         = btn.dataset.desc || '';

    const codes = parseModulesFromData(btn.dataset.modules);
    renderChips(
      document.getElementById('e-module-chips'),
      document.getElementById('e-modules'),
      codes
    );
    setModuleValidity('e', codes.length > 0);

    editModal.show();
  });

  // ---------- EDIT submit ----------
  document.getElementById('tplEditForm')?.addEventListener('submit', async function(ev){
    ev.preventDefault();
    const title = document.getElementById('e-title').value.trim();
    const desc  = document.getElementById('e-desc').value.trim();
    const mods  = (document.getElementById('e-modules').value || '').split('|').filter(Boolean);

    document.getElementById('e-title').classList.toggle('is-invalid', !title);
    document.getElementById('e-desc').classList.toggle('is-invalid', !desc);
    

    try {
      await postForm('/SubjectCoordinator/EditTemplate', getToken(this), {
        TemplateId: document.getElementById('e-id').value,
        Title:      title,
        Programme:  document.getElementById('e-programme').value,
        Status:     document.getElementById('e-status').value,
        Description:desc
      }, mods);

      editModal.hide();
      openConfirm?.('Changes saved!','Project template has been updated.');
    } catch(err) {
      alert('Save failed: ' + (err.message || err));
    }
  });

  // ---------- CREATE: open + submit ----------
  const createModalEl = document.getElementById('tplCreateModal');
  const createModal   = new bootstrap.Modal(createModalEl);
  const createForm    = document.getElementById('tplCreateForm');

  function resetCreateForm() {
    createForm.reset();
    document.getElementById('c-module-chips').innerHTML = '';
    document.getElementById('c-modules').value = '';
    document.querySelectorAll('#tplCreateForm .is-invalid').forEach(x => x.classList.remove('is-invalid'));
    document.getElementById('c-module-picker').value = '';
setModuleValidity('c', true); // hide error on fresh open

  }

  document.getElementById('btnOpenCreate')?.addEventListener('click', () => {
    resetCreateForm();
    createModal.show();
  });

  createForm?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const id    = document.getElementById('c-id').value.trim().toUpperCase();
    const title = document.getElementById('c-title').value.trim();
    const desc  = document.getElementById('c-desc').value.trim();
    const programme = document.getElementById('c-programme').value;
    const status    = document.getElementById('c-status').value;
    const mods = (document.getElementById('c-modules').value || '').split('|').filter(Boolean);

    document.getElementById('c-id').classList.toggle('is-invalid', !id);
    document.getElementById('c-title').classList.toggle('is-invalid', !title);
    document.getElementById('c-desc').classList.toggle('is-invalid', !desc);
    setModuleValidity('c', mods.length > 0);
    if (!id || !title || !desc || mods.length === 0) return;

    try {
      await postForm('/SubjectCoordinator/CreateTemplate', getToken(createForm), {
        TemplateId: id,
        Title:      title,
        Programme:  programme,
        Status:     status,
        Description:desc
      }, mods);

      createModal.hide();
      openConfirm?.('Template created!', 'The new template has been added.');
    } catch (err) {
      alert('Create failed: ' + (err.message || err));
    }
  });

  // Uppercase Template ID as user types
  document.getElementById('c-id')?.addEventListener('input', e => {
    e.target.value = (e.target.value || '').toUpperCase();
  });
})();
</script>


<script>
// ===== Live title clash in EDIT modal =====
(function(){
  const titleInput = document.getElementById('e-title');
  const idHidden   = document.getElementById('e-id');
  const saveBtn    = document.querySelector('#tplEditForm button[type="submit"]');

  const titleErr = document.createElement('div');
  titleErr.className = 'text-danger small mt-1';
  titleInput.insertAdjacentElement('afterend', titleErr);

  let timer;
  async function runCheck(){
    const idVal    = (idHidden.value || '').trim().toUpperCase();
    const titleVal = (titleInput.value || '').trim();
    if (!titleVal) { titleErr.textContent=''; saveBtn.disabled=false; return; }

    try{
      const res = await fetch(`/SubjectCoordinator/CheckTemplateUpdateAllowed?id=${encodeURIComponent(idVal)}&title=${encodeURIComponent(titleVal)}`);
      if (!res.ok) return;
      const data = await res.json();
      titleErr.textContent = data.titleClash ? '⚠️ Another template already uses this Title.' : '';
      saveBtn.disabled = !!data.titleClash;
    }catch{ /* ignore */ }
  }
  function debounced(){ clearTimeout(timer); timer = setTimeout(runCheck, 350); }

  titleInput.addEventListener('input', debounced);

  // Also enforce required fields on submit (incl. modules)
  document.getElementById('tplEditForm').addEventListener('submit', (ev) => {
    const title = titleInput.value.trim();
    const desc = document.getElementById('e-desc').value.trim();
    const modulesCsv = document.getElementById('e-modules').value.trim();
    const ok = title && desc && modulesCsv;
    if (!ok || saveBtn.disabled){
      ev.preventDefault();
      titleInput.classList.toggle('is-invalid', !title);
      document.getElementById('e-desc').classList.toggle('is-invalid', !desc);
      
    }
  });
})();
</script>

  <script>
// CSV upload (same pattern as UniAdmin)
(() => {
  const btn   = document.getElementById('btnUploadCsv');

  let input = document.getElementById('csvFile');
  if (!input) {
    input = document.createElement('input');
    input.type = 'file';
    input.accept = '.csv';
    input.multiple = false; // one file for templates
    input.className = 'visually-hidden';
    input.id = 'csvFile';
    document.body.appendChild(input);
  }

  function getAntiForgery() {
    const el = document.querySelector("input[name='__RequestVerificationToken']");
    return el ? el.value : '';
  }

  btn?.addEventListener('click', () => input?.click());

  input?.addEventListener('change', async () => {
    const files = Array.from(input.files || []);
    if (!files.length) return;

   const fd = new FormData();
fd.append('file', files[0], files[0].name);
fd.append('allowUpdates', 'true');                    

const token = getAntiForgery();
if (token) fd.append('__RequestVerificationToken', token);



    let resp, data;
    try {
      resp = await fetch('@Url.Action("UploadTemplatesCsv","SubjectCoordinator")', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin',
        headers: { 'RequestVerificationToken': token || '' }
      });

      const ct = resp.headers.get('content-type') || '';
      if (ct.includes('application/json')) {
        data = await resp.json();
      } else {
        const text = await resp.text();
        throw new Error((resp.status === 401 || resp.status === 403)
          ? 'Not authorized. Please sign in again.'
          : (text || 'Unexpected response.'));
      }
    } catch (err) {
      const list = document.getElementById('uploadErrorsList');
      list.innerHTML = `<li>${String(err.message || err).replace(/</g,'&lt;')}</li>`;
      new bootstrap.Modal(document.getElementById('mdlUploadErrors')).show();
      input.value = '';
      return;
    }

    if (!resp.ok || !data || data.ok === false) {
      const errors = (data && data.errors) ? data.errors : ['Upload failed.'];
      const list = document.getElementById('uploadErrorsList');
      list.innerHTML = errors.map(e => `<li>${e.replace(/</g,'&lt;')}</li>`).join('');
      new bootstrap.Modal(document.getElementById('mdlUploadErrors')).show();
      input.value = '';
      return;
    }

    // Success modal 
    const s = data.summary || {};
    const html = `
      <ul class="list-unstyled mb-0">
        <li><strong>Templates</strong> — inserted ${s.inserted||0}, updated ${s.updated||0}</li>
      </ul>`;
    document.getElementById('uploadSummaryBody').innerHTML = html;
    new bootstrap.Modal(document.getElementById('mdlUploadResult')).show();

    input.value = '';
    document.getElementById('mdlUploadResult')
      .addEventListener('hidden.bs.modal', () => location.reload(), { once:true });
  });
})();
</script>

<script>
