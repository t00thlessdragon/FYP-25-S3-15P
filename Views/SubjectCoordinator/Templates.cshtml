<script>
  let templatesToDelete = [];

  // Select All functionality
  document.getElementById('selectAllCheckbox')?.addEventListener('change', e => {
    document.querySelectorAll('.rowCheckbox').forEach(cb => cb.checked = e.target.checked);
  });

  
  document.getElementById('btnDeleteSelected')?.addEventListener('click', () => {
    templatesToDelete = [...document.querySelectorAll('.rowCheckbox:checked')].map(cb => cb.value);
    if (templatesToDelete.length === 0) {
      showAlert('Please select at least one template to delete.', 'warning');
      return;
    }

    // update count text
    document.getElementById('deleteCount').innerText = templatesToDelete.length;

    // show modal
    const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
    modal.show();
  });

  // Confirm deletion inside modal
  document.getElementById('confirmDeleteBtn')?.addEventListener('click', async () => {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    try {
      const res = await fetch('/SubjectCoordinator/DeleteMultipleTemplates', {
        method: 'POST',
        headers: {
          'RequestVerificationToken': token,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(templatesToDelete)
      });

      if (res.ok) {
        const modal = bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal'));
        modal.hide();
        showAlert(`${templatesToDelete.length} template(s) deleted successfully.`, 'success');
        setTimeout(() => location.reload(), 1500);
      } else {
        const msg = await res.text();
        showAlert('Delete failed: ' + msg, 'danger');
      }
    } catch (err) {
      showAlert('Error: ' + err.message, 'danger');
    }
  });

  // Helper: show alert toast at top
  function showAlert(message, type = 'info') {
    const alert = document.createElement('div');
    alert.className = `alert alert-${type} position-fixed top-0 start-50 translate-middle-x mt-3 shadow`;
    alert.style.zIndex = 2000;
    alert.textContent = message;
    document.body.appendChild(alert);
    setTimeout(() => alert.remove(), 3000);
  }
</script>
<script>
(() => {
  const form   = document.getElementById('filtersForm');
  const selProg = document.getElementById('fltProgramme');
  const selMod  = document.getElementById('fltModule');
  const selStat = document.getElementById('fltStatus');
  const txtQ    = document.getElementById('fltSearch');
  const btnReset= document.getElementById('btnResetFilters');
  const rows    = Array.from(document.querySelectorAll('tr.tpl-row'));

  function normalize(s){ return (s || '').toString().toLowerCase().trim(); }

  function applyFilters(){
    const prog = selProg.value;          
    const mod  = selMod.value;           
    const stat = normalize(selStat.value);
    const q    = normalize(txtQ.value);

    rows.forEach(tr => {
      const rProg = tr.dataset.programme || '';
      const rStat = normalize(tr.dataset.status || '');
      const rMods = (tr.dataset.modules || '').split('|').filter(Boolean);
      const hay   = normalize(tr.dataset.id + ' ' + tr.dataset.title);

      let show = true;
      if (prog && rProg !== prog) show = false;
      if (mod  && !rMods.includes(mod)) show = false;
      if (stat && rStat !== stat) show = false;
      if (q    && !hay.includes(q)) show = false;

      tr.style.display = show ? '' : 'none';
    });
  }

  form?.addEventListener('submit', (e) => { e.preventDefault(); applyFilters(); });
  selProg?.addEventListener('change', applyFilters);
  selMod?.addEventListener('change', applyFilters);
  selStat?.addEventListener('change', applyFilters);
  txtQ?.addEventListener('input',  () => { /* debounce if you like */ });

  btnReset?.addEventListener('click', () => {
    selProg.value = '';
    selMod.value  = '';
    selStat.value = '';
    txtQ.value    = '';
    applyFilters();
  });

  // initial pass (shows all)
  applyFilters();
})();
</script>



