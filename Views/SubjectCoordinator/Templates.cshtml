       <form id="csvUploadForm" asp-action="UploadTemplatesCsv" method="post" enctype="multipart/form-data" class="visually-hidden">
  @Html.AntiForgeryToken()
  <input type="file" id="csvFile" name="file" accept=".csv,text/csv" />
</form>

<a href="javascript:void(0)" class="btn btn-primary" id="btnUploadCsv"><i class="bi bi-upload me-1"></i> Upload CSV</a>
<script>
(() => {

  const elOK   = document.getElementById('imp-ok');
  const elWarn = document.getElementById('imp-warn');
  const elErr  = document.getElementById('imp-err');

  function showResult({ ok, summary, warnings = [], errors = [] }) {
    elOK.classList.add('d-none'); elWarn.classList.add('d-none'); elErr.classList.add('d-none');
    if (ok && summary) {
      elOK.textContent = `Inserted ${summary.inserted ?? 0}, Updated ${summary.updated ?? 0}.`;
      elOK.classList.remove('d-none');
    }
    if (warnings.length) {
      elWarn.innerHTML = '<ul>' + warnings.map(w => `<li>${w}</li>`).join('') + '</ul>';
      elWarn.classList.remove('d-none');
    }
    if (errors.length) {
      elErr.innerHTML = '<ul>' + errors.map(e => `<li>${e}</li>`).join('') + '</ul>';
      elErr.classList.remove('d-none');
    }
    modal.show();
    if (ok && (!errors || errors.length === 0)) {
      document.getElementById('tplImportResultModal')
        .addEventListener('hidden.bs.modal', () => location.reload(), { once: true });
    }
  }

  btn.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', async () => {
    if (!fileInput.files.length) return;

    const fd = new FormData(form);               
fd.append('allowUpdates', 'true');           

    try {
      const res  = await fetch(form.action, {
        method: 'POST',
        body: fd,
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        },
        credentials: 'same-origin'
      });

      const ct = res.headers.get('content-type') || '';
      if (!ct.includes('application/json')) {
        const text = await res.text();
        throw new Error(text || 'Unexpected response.');
      }
      const data = await res.json();

      if (!res.ok || data.ok === false)
        showResult({ ok:false, warnings: data.warnings || [], errors: data.errors || ['Upload failed.'] });
      else
        showResult({ ok:true, summary: data.summary || { inserted:0, updated:0 }, warnings: data.warnings || [] });

    } catch (err) {
      showResult({ ok:false, errors: [String(err.message || err)] });
    } finally {
      form.reset();
    }
  });
})();
</script>


