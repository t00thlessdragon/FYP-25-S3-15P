@section Scripts{
  <!-- VIEW modal: show modules as "CODE Name" tags -->
  <script>
  (function () {
    const modalEl = document.getElementById('tplViewModal');
    const modal   = new bootstrap.Modal(modalEl);

    function parseCodes(str){
      if (!str) return [];
      return str.split(/[,\|]/).map(s => s.trim()).filter(Boolean);
    }
    function codeToLabel(code){
      const opt = document.querySelector(`#c-module-picker option[value="${code}"]`)
               || document.querySelector(`#e-module-picker option[value="${code}"]`);
      return opt ? opt.textContent : code; // fallback to code
    }
    function progCodeToLabel(code){
    const opt = document.querySelector(`#c-programme option[value="${code}"]`)
             || document.querySelector(`#e-programme option[value="${code}"]`);
    return opt ? opt.textContent : code;
  }
    function renderViewTags(container, codes){
      container.innerHTML = '';
      codes.forEach(c => {
        const tag = document.createElement('span');
        tag.className = 'badge rounded-pill bg-secondary-subtle text-dark border px-3 py-2 me-2 mb-2';
        tag.textContent = codeToLabel(c);
        container.appendChild(tag);
      });
    }

    function badgeClassFor(status){
  const s = (status || '').toLowerCase();
  if (s === 'active')   return 'text-bg-success';
  if (s === 'inactive') return 'text-bg-danger';
  if (s === 'draft')    return 'text-bg-primary';
  return 'text-bg-secondary';
}

function fillAndShow(btn) {
  document.getElementById('v-id').textContent    = btn.dataset.id ?? '';
  document.getElementById('v-title').textContent = btn.dataset.title ?? '';

  // Programme: convert code -> "CODE - Name"
  const progLabel = progCodeToLabel(btn.dataset.programme || '');
  document.getElementById('v-programme').textContent = progLabel;

  // Status: colored badge
  const st = btn.dataset.status || '';
  document.getElementById('v-status').innerHTML =
    `<span class="badge rounded-pill ${badgeClassFor(st)}">${st}</span>`;

  document.getElementById('v-desc').textContent  = btn.dataset.desc ?? '';

  const mods = parseCodes(btn.dataset.modules);
  renderViewTags(document.getElementById('v-modules'), mods);
  modal.show();
}


    function fillAndShow(btn) {
      document.getElementById('v-id').textContent        = btn.dataset.id ?? '';
      document.getElementById('v-title').textContent     = btn.dataset.title ?? '';
      document.getElementById('v-programme').textContent = btn.dataset.programme ?? '';
      document.getElementById('v-status').textContent    = btn.dataset.status ?? '';
      document.getElementById('v-desc').textContent      = btn.dataset.desc ?? '';

      const mods = parseCodes(btn.dataset.modules);
      renderViewTags(document.getElementById('v-modules'), mods);
      modal.show();
    }

    document.addEventListener('click', function (e) {
      const target = e.target.closest('.js-view-template');
      if (target) {
        e.preventDefault();
        fillAndShow(target);
      }
    });
  })();
  </script>


<script>
// ===== Live duplicate checks in CREATE modal =====
(function(){
  const idInput    = document.getElementById('c-id');
  const titleInput = document.getElementById('c-title');
  const saveBtn    = document.querySelector('#tplCreateForm button[type="submit"]');

  // inline error placeholders
  const idErr    = document.createElement('div');
