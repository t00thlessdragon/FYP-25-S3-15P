@* Allocation Summary Partial *@
<div>
    <h4 class="mb-3">Allocation Summary</h4>

    <div class="mb-3 d-flex justify-content-between align-items-center">
        <p class="text-muted mb-0">Displays current project and student allocation status.</p>
        <button class="btn btn-sm btn-outline-dark">Generate Report</button>
    </div>
    <form asp-action="RunAllocation" asp-controller="SubjectCoordinator" method="post" class="mb-3 d-flex flex-column gap-3">

    <div class="d-flex gap-3 align-items-end">
        <!-- Year dropdown -->
        <div>
            <label class="form-label">Year</label>
            <select id="yearSelect" class="form-select">
                <option value="">Select Year</option>
                @foreach (var y in ViewBag.Years)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>

        <!-- Program dropdown -->
        <div>
            <label class="form-label">Program</label>
            <select id="programSelect" class="form-select">
                <option value="">Select Program</option>
                @foreach (var p in ViewBag.Programs)
                {
                    <option value="@p.ID">@p.ProgramName</option>
                }
            </select>
        </div>

        <!-- Session dropdown -->
        <div>
            <label class="form-label">Session</label>
            <select id="sessionSelect" name="programConstraintID" class="form-select">
                <option value="">Select Session</option>
                @foreach (var s in ViewBag.Sessions)
                {
                    <option value="@s.Id" data-program="@s.ProgramId" data-year="@s.Year">
                        Session @s.SessionNo (ProgramID: @s.ProgramId)
                    </option>
                }
            </select>
        </div>

        <button class="btn btn-primary">Run Auto Allocation</button>
    </div>

    @if (TempData["AllocationMessage"] is string msg)
    {
        <div class="alert alert-info mb-0">@msg</div>
    }
</form>

    <!-- Student Allocation Table -->
    <h5>Student Allocation</h5>
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>No</th>
                    <th>Student ID</th>
                    <th>Student Name</th>
                    <th>Current Project</th>
                    <th>Allocation Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>UOW45678</td>
                    <td>Tommy Lee</td>
                    <td>A Smart Project Allocation System</td>
                    <td><span class="badge bg-success">Allocated</span></td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>UOW98756</td>
                    <td>Peter Pan</td>
                    <td>-</td>
                    <td><span class="badge bg-danger">Unallocated</span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Project Allocation Table -->
    <h5>Project Allocation</h5>
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>No</th>
                    <th>Project ID</th>
                    <th>Project Title</th>
                    <th>Group ID</th>
                    <th>Supervisor</th>
                    <th>Assessor</th>
                    <th>Students</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>CSIT-25-S3-08</td>
                    <td>A Smart Project Allocation System</td>
                    <td>FYP-25-S3-15P</td>
                    <td>Mr Prem</td>
                    <td>Mr Tam</td>
                    <td>Tommy, Jacob, Susan, Bruce</td>
                    <td><span class="badge bg-success">Allocated</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary">Adjust</button>
                        <button class="btn btn-sm btn-outline-success">Approve</button>
                        <button class="btn btn-sm btn-outline-danger">Reject</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Adjust Project Allocation Modal -->
<div class="modal fade" id="adjustAllocationModal" tabindex="-1" aria-labelledby="adjustAllocationLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="adjustAllocationLabel">Adjust Project Allocation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="mb-3">
                    <label for="supervisorSelect" class="form-label">Supervisor</label>
                    <select id="supervisorSelect" class="form-select">
                        <option value="">-- Select Supervisor --</option>
                        <option value="Tom">Tom</option>
                        <option value="Tom John">Tom John</option>
                        <option value="Tommy Frank">Tommy Frank</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="assessorSelect" class="form-label">Assessor</label>
                    <select id="assessorSelect" class="form-select">
                        <option value="">-- Select Assessor --</option>
                        <option value="Tam">Tam</option>
                        <option value="Tan">Tan</option>
                        <option value="Tay">Tay</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Students</label>
                    <div id="studentList">
                        <div class="input-group mb-2">
                            <input type="text" class="form-control" value="Tommy Lee" />
                            <button class="btn btn-outline-danger remove-student" type="button">&times;</button>
                        </div>
                        <div class="input-group mb-2">
                            <input type="text" class="form-control" value="Jacob Joan" />
                            <button class="btn btn-outline-danger remove-student" type="button">&times;</button>
                        </div>
                        <div class="input-group mb-2">
                            <input type="text" class="form-control" value="Susan Lim" />
                            <button class="btn btn-outline-danger remove-student" type="button">&times;</button>
                        </div>
                    </div>
                    <button id="addStudentBtn" type="button" class="btn btn-outline-secondary btn-sm">Add Student</button>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary">Adjust</button>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Open modal on Adjust button click
        document.querySelectorAll('.btn-outline-primary').forEach(btn => {
            btn.addEventListener('click', () => {
                const modal = new bootstrap.Modal(document.getElementById('adjustAllocationModal'));
                modal.show();
            });
        });

        // Add student input field
        document.getElementById('addStudentBtn').addEventListener('click', () => {
            const list = document.getElementById('studentList');
            const div = document.createElement('div');
            div.classList.add('input-group', 'mb-2');
            div.innerHTML = `
                <input type="text" class="form-control" placeholder="Enter student name" />
                <button class="btn btn-outline-danger remove-student" type="button">&times;</button>
            `;
            list.appendChild(div);
        });

        // Remove student input field
        document.getElementById('studentList').addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-student')) {
                e.target.closest('.input-group').remove();
            }
        });

        const yearSelect = document.getElementById('yearSelect');
        const programSelect = document.getElementById('programSelect');
        const sessionSelect = document.getElementById('sessionSelect');
        const allSessions = Array.from(sessionSelect.options);

        function filterSessions() {
            const year = yearSelect.value;
            const program = programSelect.value;

            // Reset
            sessionSelect.innerHTML = '<option value="">Select Session</option>';

            // Filter
            const filtered = allSessions.filter(opt =>
                opt.dataset.year === year && opt.dataset.program === program
            );

            filtered.forEach(opt => sessionSelect.appendChild(opt.cloneNode(true)));
        }

        yearSelect.addEventListener('change', filterSessions);
        programSelect.addEventListener('change', filterSessions);
    });
</script>
