<!-- Allocation Run Detail Modal -->
<div class="modal fade" id="allocationRunDetailModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Allocation Run Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <div id="allocationRunDetailContainer">
          <p class='text-muted'>Loading...</p>
        </div>
        <div class="modal-footer">
                <button id="btn-save-allocation" class="btn btn-success" data-run="">Save Allocation</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
      </div>
    </div>
  </div>
</div>








<!-- Adjust Project Allocation Modal -->
<div class="modal fade" id="adjustAllocationModal" tabindex="-1" aria-labelledby="adjustAllocationLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="adjustAllocationLabel">Adjust Project Allocation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="mb-3">
                    <label for="supervisorSelect" class="form-label">Supervisor</label>
                    <select id="supervisorSelect" class="form-select">
                        <option value="">-- Select Supervisor --</option>
                        <option value="Tom">Tom</option>
                        <option value="Tom John">Tom John</option>
                        <option value="Tommy Frank">Tommy Frank</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="assessorSelect" class="form-label">Assessor</label>
                    <select id="assessorSelect" class="form-select">
                        <option value="">-- Select Assessor --</option>
                        <option value="Tam">Tam</option>
                        <option value="Tan">Tan</option>
                        <option value="Tay">Tay</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Students</label>
                    <div id="studentList">
                        <div class="input-group mb-2">
                            <input type="text" class="form-control" value="Tommy Lee" />
                            <button class="btn btn-outline-danger remove-student" type="button">&times;</button>
                        </div>
                        <div class="input-group mb-2">
                            <input type="text" class="form-control" value="Jacob Joan" />
                            <button class="btn btn-outline-danger remove-student" type="button">&times;</button>
                        </div>
                        <div class="input-group mb-2">
                            <input type="text" class="form-control" value="Susan Lim" />
                            <button class="btn btn-outline-danger remove-student" type="button">&times;</button>
                        </div>
                    </div>
                    <button id="addStudentBtn" type="button" class="btn btn-outline-secondary btn-sm">Add Student</button>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary">Adjust</button>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        loadAllRuns();
        // Open modal on Adjust button click
        document.querySelectorAll('.btn-outline-primary').forEach(btn => {
            btn.addEventListener('click', () => {
                const modal = new bootstrap.Modal(document.getElementById('adjustAllocationModal'));
                modal.show();
            });
        });

        // Add student input field
        document.getElementById('addStudentBtn').addEventListener('click', () => {
            const list = document.getElementById('studentList');
            const div = document.createElement('div');
            div.classList.add('input-group', 'mb-2');
            div.innerHTML = `
                <input type="text" class="form-control" placeholder="Enter student name" />
                <button class="btn btn-outline-danger remove-student" type="button">&times;</button>
            `;
            list.appendChild(div);
        });

        // Remove student input field
        document.getElementById('studentList').addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-student')) {
                e.target.closest('.input-group').remove();
            }
        });

        const yearSelect = document.getElementById('yearSelect');
        const programSelect = document.getElementById('programSelect');
        const sessionSelect = document.getElementById('sessionSelect');
        const allSessions = Array.from(sessionSelect.options);

        function filterSessions() {
            const year = yearSelect.value;
            const program = programSelect.value;

            // Reset
            sessionSelect.innerHTML = '<option value="">Select Session</option>';

            // Filter
            const filtered = allSessions.filter(opt =>
                opt.dataset.year === year && opt.dataset.program === program
            );

            filtered.forEach(opt => sessionSelect.appendChild(opt.cloneNode(true)));
        }

        yearSelect.addEventListener('change', filterSessions);
        programSelect.addEventListener('change', filterSessions);

        async function loadAllRuns() {
            const tbody = document.getElementById("runsTableBody");
            tbody.innerHTML = `<tr><td colspan="10" class="text-center text-muted">Loading...</td></tr>`;

            try {
                const res = await fetch('/SubjectCoordinator/GetAllAllocationRuns');
                const runs = await res.json();

                tbody.innerHTML = "";

                if (runs.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="10" class="text-center text-muted">No allocation runs found.</td></tr>`;
                    return;
                }

                let i = 1;
                for (const r of runs) {
                    tbody.innerHTML += `
                        <tr>
                            <td>${i++}</td>
                            <td>${r.year}</td>
                            <td>${r.programName}</td>
                            <td>S${r.session}</td>
                            <td>${r.startedAt}</td>
                            <td>${r.finishedAt}</td>
                            <td>${r.status}</td>
                            <td>${r.avgScore}</td>
                            <td>${r.unassigned}</td>
                            <td>
                                <button class="btn btn-primary btn-sm js-view-run" data-run="${r.id}">View</button>
                            </td>
                        </tr>
                    `;
                }

            } catch (error) {
                tbody.innerHTML = `<tr><td colspan="10" class="text-danger text-center">Error loading data</td></tr>`;
            }
        }
    });

document.addEventListener("click", async function (e) {
    const btn = e.target.closest(".js-view-run");
    if (!btn) return;

    const runId = btn.dataset.run;

     // Store runId into the Save button
    document.getElementById("btn-save-allocation").dataset.run = runId;

    const container = document.getElementById("allocationRunDetailContainer");
    container.innerHTML = "<p class='text-muted'>Loading...</p>";

    const modal = new bootstrap.Modal(document.getElementById('allocationRunDetailModal'));
    modal.show();

    try {
        const res = await fetch(`/SubjectCoordinator/GetAllocationRunDetails?runId=${runId}`);
        if (!res.ok) {
            container.innerHTML = `<div class='text-danger'>Failed to load details.</div>`;
            return;
        }

        const data = await res.json();
        renderRunDetails(container, data);

    } catch (err) {
        container.innerHTML = `<div class='text-danger'>Error: ${err.message}</div>`;
    }
});

document.getElementById("btn-save-allocation").addEventListener("click", async () => {
    const btn = document.getElementById("btn-save-allocation");
    const runId = btn.dataset.run;

    if (!runId) {
        alert("Run ID missing.");
        return;
    }

    btn.disabled = true;
    btn.innerHTML = "Saving...";

    try {
        const res = await fetch(`/SubjectCoordinator/ConfirmAllocationRun`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ runId: Number(runId) })
        });

        if (!res.ok) {
            const txt = await res.text();
            alert("Error: " + txt);
            btn.disabled = false;
            btn.innerHTML = "Save Allocation";
            return;
        }

        alert("Allocation saved successfully!");
        btn.innerHTML = "Saved!";
    }
    catch (err) {
        alert("Error: " + err.message);
        btn.innerHTML = "Save Allocation";
        btn.disabled = false;
    }
});

function roleName(roleId) {
    if (roleId == 6) return "Student";
    if (roleId == 5) return "Supervisor";
    if (roleId == 4) return "Assessor";
    return "Unknown";
}



function renderRunDetails(container, data) {
    if (!data || data.length === 0) {
        container.innerHTML = "<p>No allocation data found for this run.</p>";
        return;
    }

    let html = "";

    data.forEach(project => {
        html += `
        <div class="mb-4">
            <h4>${project.projectId} — ${project.projectTitle}</h4>
        `;

        project.groups.forEach(group => {
            html += `
            <div class="card mb-3">
              <div class="card-header">
                <strong>Group ${group.groupId}</strong>
              </div>
              <div class="card-body p-2">
                <table class="table table-sm table-bordered mb-0">
                  <thead>
                    <tr>
                      <th>User</th>
                      <th>Email</th>
                      <th>Role</th>
                      <th>Preference Rank</th>
                      <th>Score</th>
                      <th>Matched Modules</th>
                    </tr>
                  </thead>
                  <tbody>
            `;

            group.members.forEach(m => {
                html += `
                  <tr>
                    <td>${m.userName}</td>
                    <td>${m.userEmail}</td>
                    <td>${roleName(m.roleId)}</td>
                    <td>${m.preferenceRank ?? "-"}</td>
                    <td>${m.score}</td>
                    <td>${m.matchedModules}</td>
                  </tr>
                `;
            });

            html += `
                  </tbody>
                </table>
              </div>
            </div>`;
        });

        html += "</div>";
    });

    container.innerHTML = html;
}

</script>
