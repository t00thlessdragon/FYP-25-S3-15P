@model IEnumerable<dynamic>
@{
    Layout = "~/Views/Shared/_SubjectCoordinatorLayout.cshtml";
    ViewData["Title"] = "Group";
    var projId = (string)(ViewBag.ProjectId ?? "—");
}

<section class="container-wide card-xl">
  <div class="card rounded-4 p-4 p-lg-5 shadow-lg">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="mb-0 fw-bold">Group: @projId</h3>

      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-danger">
          <i class="bi bi-trash me-1"></i> Delete
        </button>

        <a asp-action="Projects"
       asp-controller="SubjectCoordinator"
       asp-route-tab="groups"
       class="btn-close"
       aria-label="Close"></a>
      </div>
    </div>

    <!-- Filters -->
    <form class="row g-2 align-items-center mb-3">
      <div class="col-12 col-md-3">
        <select class="form-select"><option>Group: All</option></select>
      </div>
      <div class="col-12 col-md-3">
        <select class="form-select"><option>Supervisor:</option></select>
      </div>
      <div class="col-12 col-md-3">
        <select class="form-select"><option>Assessor:</option></select>
      </div>
      <div class="col-12 col-md-3">
        <div class="input-group">
          <input class="form-control" placeholder="Search" />
          <button class="btn btn-dark" type="button"><i class="bi bi-search"></i></button>
        </div>
      </div>
    </form>

    <!-- Table -->
    <div class="table-responsive">
      <table class="table table-hover align-middle w-100">
        <thead class="table-dark">
          <tr>
            <th style="width:50px" class="text-center"><input type="checkbox" /></th>
            <th style="width:220px;">Group ID</th>
            <th style="width:140px;">Members</th>
            <th>Supervisor</th>
            <th>Assessor</th>
            <th style="width:180px;" class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var g in Model)
          {
            <tr>
              <td class="text-center"><input type="checkbox" /></td>
              <td class="text-muted">@g.GroupId</td>
              <td>@g.Members</td>
              <td>@g.Supervisor</td>
              <td>@g.Assessor</td>
              <td class="text-end">
                <a asp-controller="SubjectCoordinator"
   asp-action="GroupDetails"
   asp-route-groupId="FYP-25-S3-15P"
   class="btn btn-dark btn-sm">View Details</a>


              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
