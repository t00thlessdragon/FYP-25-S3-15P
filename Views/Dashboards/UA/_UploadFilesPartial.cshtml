<!-- Upload Files Section -->
<div class="dropdown mb-4 text-end">
  <button class="btn btn-primary dropdown-toggle" type="button" id="uploadDropdown" data-bs-toggle="dropdown" aria-expanded="false">
    <i class="bi bi-upload"></i> Upload Files
  </button>
  <ul class="dropdown-menu" aria-labelledby="uploadDropdown">

    <!-- Staff Upload -->
    <li>
      <form id="uploadStaffForm" enctype="multipart/form-data" method="post" class="px-3 py-2">
        @Html.AntiForgeryToken() <!-- Ensure anti-forgery token is included -->
        <label class="form-label small">Upload Staff (.csv)</label>
        <input type="file" name="staffFile" accept=".csv" class="form-control form-control-sm mb-2" required />
        <button type="submit" class="btn btn-sm btn-success w-100">Upload Staff</button>
      </form>
    </li>

    <li><hr class="dropdown-divider" /></li>

    <!-- Student Upload (NEW SECTION) -->
    <li>
      <form id="uploadStudentForm" enctype="multipart/form-data" method="post" class="px-3 py-2">
        @Html.AntiForgeryToken()
        <label class="form-label small">Upload Students (.csv)</label>
        <input type="file" name="studentFile" accept=".csv" class="form-control form-control-sm mb-2" required />
        <button type="submit" class="btn btn-sm btn-info w-100 text-white">Upload Students</button>
      </form>
    </li>
    
  </ul>
</div>

<!-- Upload Success Modal -->
<div class="modal fade" id="uploadSuccessModal" tabindex="-1" aria-labelledby="uploadSuccessLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg"> <!-- Changed to modal-lg for better visibility of details -->
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="uploadSuccessLabel">Upload Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="uploadSuccessMessage">
        File uploaded successfully!
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript to handle AJAX submission -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> <!-- FIX: Include jQuery -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script> <!-- FIX: Include Bootstrap JS Bundle for modal functionality -->
<script>
  $(document).ready(function () {
    
    // --- Generic AJAX Submission Handler ---
    function handleFileUpload(formId, url, fileInputName) {
        $(`#${formId}`).on('submit', function (event) {
            event.preventDefault(); 

            var formData = new FormData(this);

            // Add a simple loading indicator (optional)
            const submitButton = $(`#${formId} button[type="submit"]`);
            submitButton.attr('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...');

            $.ajax({
                url: url, 
                type: 'POST',
                data: formData,
                contentType: false,  
                processData: false,  
                success: function (response) {
                    
                    let messageHtml = `<h6>${response.message}</h6>`;
                    
                    // --- NEW LOGIC TO DISPLAY SKIP DETAILS ---
                    if (response.skipDetails && response.skipDetails.length > 0) {
                        messageHtml += '<hr class="my-3">';
                        messageHtml += '<p class="fw-bold text-danger">⚠️ Detailed Skip Reasons (Check your CSV/DB setup):</p>';
                        messageHtml += '<div class="alert alert-light p-2" style="max-height: 300px; overflow-y: scroll; font-size: 0.85rem;">';
                        
                        // Display the first 10 reasons, then show a count for the rest
                        const maxDisplayed = 10;
                        const totalSkipped = response.skipDetails.length;
                        
                        response.skipDetails.slice(0, maxDisplayed).forEach(function(reason) {
                            messageHtml += `<div>${reason}</div>`;
                        });
                        
                        if (totalSkipped > maxDisplayed) {
                            messageHtml += `<div class="mt-2 text-primary fst-italic">... and ${totalSkipped - maxDisplayed} more rows skipped for similar reasons.</div>`;
                        }
                        
                        messageHtml += '</div>';
                    }
                    // --- END NEW LOGIC ---

                    $('#uploadSuccessMessage').html(messageHtml); // Use .html() to render the message with formatting
                    $('#uploadSuccessModal').modal('show');
                    $(`#${formId}`)[0].reset();
                },
                error: function (xhr, status, error) {
                    console.error('Error occurred during the upload:', status, error);
                    console.error('Response:', xhr.responseText);
                    
                    let errorMessage = "A major error occurred during upload. Check console for details.";
                    try {
                        const jsonResponse = JSON.parse(xhr.responseText);
                        if (jsonResponse.message) {
                            errorMessage = jsonResponse.message;
                        }
                    } catch (e) {
                        // Ignore JSON parsing errors
                    }

                    $('#uploadSuccessMessage').text(errorMessage);
                    $('#uploadSuccessModal').modal('show');
                },
                complete: function() {
                    // Re-enable button
                    submitButton.attr('disabled', false).html(
                        formId === 'uploadStaffForm' ? 'Upload Staff' : 'Upload Students'
                    );
                }
            });
        });
    }

    // Initialize handlers for both forms
    handleFileUpload('uploadStaffForm', '/FileUpload/UploadStaff', 'staffFile');
    handleFileUpload('uploadStudentForm', '/FileUpload/UploadStudent', 'studentFile');
  });
</script>
