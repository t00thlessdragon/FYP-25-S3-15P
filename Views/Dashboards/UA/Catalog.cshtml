<script>
//CSV upload
(() => {
  const btn   = document.getElementById('btnUploadCsv');
  const input = document.getElementById('csvFiles');

  // Read any anti-forgery token already rendered on the page
  function getAntiForgery() {
    const el = document.querySelector("input[name='__RequestVerificationToken']");
    return el ? el.value : '';
  }

  btn?.addEventListener('click', () => input?.click());

  input?.addEventListener('change', async () => {
    const files = Array.from(input.files || []);
    if (!files.length) return;

    const fd = new FormData();
    files.forEach(f => fd.append('files', f, f.name));

    // Include anti-forgery token both as field and header
    const token = getAntiForgery();
    if (token) fd.append('__RequestVerificationToken', token);

    let resp, data;

    try {
      resp = await fetch('@Url.Action("UploadCatalogCsv","UADashboard")', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin',                            
        headers: { 'RequestVerificationToken': token || '' }   
      });

      // Only try JSON if the server actually sent JSON
      const ct = resp.headers.get('content-type') || '';
      if (ct.includes('application/json')) {
        data = await resp.json();
      } else {
        const text = await resp.text();
        throw new Error(
          (resp.status === 401 || resp.status === 403)
            ? 'Not authorized. Please sign in again.'
            : (text || 'Unexpected response.')
        );
      }
    } catch (err) {
      const list = document.getElementById('uploadErrorsList');
      list.innerHTML = `<li>${String(err.message || err).replace(/</g,'&lt;')}</li>`;
      new bootstrap.Modal(document.getElementById('mdlUploadErrors')).show();
      input.value = '';
      return;
    }

    if (!resp.ok || !data || data.ok === false) {
      const errors = (data && data.errors) ? data.errors : ['Upload failed.'];
      const list = document.getElementById('uploadErrorsList');
      list.innerHTML = errors.map(e => `<li>${e.replace(/</g,'&lt;')}</li>`).join('');
      new bootstrap.Modal(document.getElementById('mdlUploadErrors')).show();
      input.value = '';
      return;
    }

    // Success modal
    const s = data.summary || {};
    const html = `
      <ul class="list-unstyled mb-0">
        <li><strong>Programs</strong> — inserted ${s.programsInserted||0}, updated ${s.programsUpdated||0}</li>
        <li><strong>Courses</strong> — inserted ${s.coursesInserted||0}, updated ${s.coursesUpdated||0}</li>
        <li><strong>Modules</strong> — inserted ${s.modulesInserted||0}, updated ${s.modulesUpdated||0}</li>
      </ul>`;
    document.getElementById('uploadSummaryBody').innerHTML = html;
    new bootstrap.Modal(document.getElementById('mdlUploadResult')).show();

    input.value = '';
    document.getElementById('mdlUploadResult').addEventListener('hidden.bs.modal', () => location.reload(), { once:true });
  });
})();
</script>

<script>
//Clear forms when opening create modals
(function () {
  const reopenedId = '@(reopenId ?? "")';
  // Wipe inputs when a modal opens (fresh create flows)
  function clearOnOpen(modalId) {
    const modal = document.getElementById(modalId);
    if (!modal) return;

    modal.addEventListener('show.bs.modal', () => {
      // Keep values when re-opening because of server validation errors
      if (reopenedId && modalId === reopenedId) return;

      const form = modal.querySelector('form');
      if (!form) return;

      form.reset();
      form.classList.remove('was-validated');

      // text inputs + textareas
      form.querySelectorAll('input:not([type=hidden]):not([type=radio]):not([type=checkbox]), textarea')
          .forEach(el => { el.value = ''; el.classList.remove('is-invalid'); });

      // uncheck radios/checkboxes
      form.querySelectorAll('input[type=radio],input[type=checkbox]')
          .forEach(el => { el.checked = false; el.classList.remove('is-invalid'); });

      // selects
      form.querySelectorAll('select').forEach(sel => {
        sel.classList.remove('is-invalid');
        Array.from(sel.options).forEach(o => (o.selected = false));
        sel.selectedIndex = -1; // nothing selected
      });

      // clear any embedded search boxes in the list
      form.querySelectorAll('.search-row input').forEach(s => {
        s.value = '';
        s.dispatchEvent(new Event('input', { bubbles: true }));
      });
    });
  }

  ['mdlCreateProgram','mdlCreateCourse','mdlCreateModule'].forEach(clearOnOpen);
})();
</script>

<script>
// Wire “search in modal lists” filters
(function () {
  function wireModalFilter(modalId, inputId, listSelector) {
    const modal = document.getElementById(modalId);
    if (!modal) return;

    modal.addEventListener('shown.bs.modal', function () {
      const q = document.getElementById(inputId);
      const items = Array.from(document.querySelectorAll(listSelector + ' .list-group-item'));
      if (!q || !items.length) return;

      // reset + focus every time the modal opens
      q.value = '';
      q.focus();

      const doFilter = () => {
        const term = q.value.trim().toLowerCase();
        let firstVisible = null;

        items.forEach(li => {
          const hay = li.innerText.toLowerCase();
          const match = !term || hay.includes(term);
          li.style.display = match ? '' : 'none';
          if (match && !firstVisible) firstVisible = li;
        });

        if (firstVisible) firstVisible.scrollIntoView({ block: 'nearest' });
      };

      q.oninput = doFilter;
      q.onkeyup = doFilter;   
      doFilter();
    });
  }

  // Programs
  wireModalFilter('mdlSelectProgram',        'searchProgramUpd', '#listProgramUpd');
  wireModalFilter('mdlSelectProgramDelete',  'searchProgramDel', '#listProgramDel');

  // Courses
  wireModalFilter('mdlSelectCourse',         'searchCourseUpd',  '#listCourseUpd');
  wireModalFilter('mdlSelectCourseDelete',   'searchCourseDel',  '#listCourseDel');

  // (optional) Modules too, for completeness
  wireModalFilter('mdlSelectModule',         'searchModuleUpd',  '#listModuleUpd');
  wireModalFilter('mdlSelectModuleDelete',   'searchModuleDel',  '#listModuleDel');
})();
</script>

<script>
(function () {
  // add an extra check for Module forms: require at least one CourseCodes checked
  function needsCourseValidation(form) {
    const action = (form.getAttribute('action') || '').toLowerCase();
    return action.endsWith('/createmodule') || action.endsWith('/updatemodule');
  }

  document.querySelectorAll('.needs-validation').forEach(form => {
    form.addEventListener('submit', (e) => {
      if (!needsCourseValidation(form)) return;

      const any = form.querySelectorAll('input[name="CourseCodes"]:checked').length > 0;
      const msgId = form.id === 'mdlCreateModule' ? 'createModCoursesInvalid' : 'updateModCoursesInvalid';
      const msg = document.getElementById(msgId);

      if (!any) {
        e.preventDefault(); e.stopPropagation();
        msg?.classList.remove('d-none');
        form.classList.add('was-validated');
      } else {
        msg?.classList.add('d-none');
      }
    }, false);
  });
})();
</script>

<script>
// Searchable course list
(function () {
  function score(item, q) {
    if (!q) return 0;
    const code = (item.dataset.code || '').toLowerCase();
    const name = (item.dataset.name || '').toLowerCase();
    if (code === q || name === q) return 1000;
    if (code.startsWith(q) || name.startsWith(q)) return 800;
    if (code.includes(q)) return 500;
    if (name.includes(q)) return 300;
    return 0;
  }
  function makeCourseSearchable(boxId, inputId) {
    const box = document.getElementById(boxId);
    const qEl = document.getElementById(inputId);
    if (!box || !qEl) return;
    const items = Array.from(box.querySelectorAll('.course-item'));
    items.forEach((li, i) => li.dataset.idx ??= String(i));
    function apply() {
      const q = qEl.value.trim().toLowerCase();
      items.forEach(li => {
        const s = score(li, q);
        li.style.display = q ? (s > 0 ? '' : 'none') : '';
      });
      const visible = items.filter(li => li.style.display !== 'none')
        .sort((a,b) => {
          const sa = score(a,q), sb = score(b,q);
          return sa !== sb ? sb - sa :
            (parseInt(a.dataset.idx||'0') - parseInt(b.dataset.idx||'0'));
        });
      visible.forEach(li => box.appendChild(li));
      if (visible.length) visible[0].scrollIntoView({ block:'nearest' });
    }
    qEl.addEventListener('input', apply);
    qEl.addEventListener('keydown', e => { if (e.key === 'Escape') { qEl.value=''; apply(); }});
  }
  makeCourseSearchable('courseList_Create','courseSearch_Create');
  makeCourseSearchable('courseList_Update','courseSearch_Update');
})();
</script>

