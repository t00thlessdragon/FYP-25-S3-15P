<script>
//Main toolbar filters
document.addEventListener('DOMContentLoaded', function () {
  const pgSel = document.getElementById('fltProgram');
  const crSel = document.getElementById('fltCourse');
  const qInp  = document.getElementById('fltSearch');

  const listP = document.getElementById('listPrograms');
  const listC = document.getElementById('listCourses');
  const listM = document.getElementById('listModules'); // may be null if not rendered

  if (!(pgSel && crSel && qInp && listP && listC)) return;

  // ——— Build Course - Program map once from the list
  const courseProgram = {};
  listC.querySelectorAll('.list-group-item').forEach(li => {
    courseProgram[(li.dataset.code || '').trim()] = (li.dataset.program || '').trim();
  });

  // ——— Keep original Course <option>s so we can re-filter them when Program changes
  const allCourseOptions = Array.from(crSel.options).map(o => o.cloneNode(true));

  function normalize(s) { return (s || '').toLowerCase().trim(); }
  function textMatch(el, needle) {
    if (!needle) return true;
    const hay = normalize(el.dataset.code) + ' ' + normalize(el.dataset.name);
    return hay.includes(needle);
  }

  function repopulateCourses(programCode) {
    const pg = programCode || '';
    const allOpt = allCourseOptions.find(o => !o.value); // "Course: All"
    crSel.innerHTML = '';
    if (allOpt) crSel.appendChild(allOpt.cloneNode(true));
    allCourseOptions.forEach(opt => {
      if (!opt.value) return;
      const belongsTo = (opt.getAttribute('data-program') || '').trim();
      if (!pg || belongsTo === pg) crSel.appendChild(opt.cloneNode(true));
    });
    crSel.value = ''; 
  }

  function moduleMatchesProgram(modLi, programCode) {
    if (!programCode) return true;
    const cs = (modLi.dataset.courses || '').split('|').filter(Boolean);
    return cs.some(c => courseProgram[c] === programCode);
  }
  function moduleMatchesCourse(modLi, courseCode) {
    if (!courseCode) return true;
    const cs = (modLi.dataset.courses || '').split('|').filter(Boolean);
    return cs.includes(courseCode);
  }

  function applyFilters() {
    const program = (pgSel.value || '').trim();
    const course  = (crSel.value || '').trim();
    const q       = normalize(qInp.value);

    // Programs
    listP.querySelectorAll('.list-group-item').forEach(li => {
      const show = (!program || li.dataset.code === program) && textMatch(li, q);
      li.classList.toggle('d-none', !show);
    });

    // Courses
    listC.querySelectorAll('.list-group-item').forEach(li => {
      const show =
        (!program || li.dataset.program === program) &&
        (!course  || li.dataset.code === course) &&
        textMatch(li, q);
      li.classList.toggle('d-none', !show);
    });

    // Modules (if present)
    if (listM) {
      listM.querySelectorAll('.list-group-item').forEach(li => {
        const show =
          moduleMatchesCourse(li, course) &&
          (course ? true : moduleMatchesProgram(li, program)) &&
          textMatch(li, q);
        li.classList.toggle('d-none', !show);
      });
    }
  }

  // ——— Clicking rows syncs the toolbar
  listP.addEventListener('click', (e) => {
    const row = e.target.closest('.list-group-item'); if (!row) return;
    pgSel.value = row.dataset.code || '';
    repopulateCourses(pgSel.value);
    crSel.value = '';
    applyFilters();
  });

  listC.addEventListener('click', (e) => {
    const row = e.target.closest('.list-group-item'); if (!row) return;
    const prog = row.dataset.program || '';
    if (pgSel.value !== prog) { pgSel.value = prog; repopulateCourses(prog); }
    crSel.value = row.dataset.code || '';
    applyFilters();
  });

  // ——— Toolbar events
  pgSel.addEventListener('change', () => { repopulateCourses(pgSel.value); applyFilters(); });
  crSel.addEventListener('change', applyFilters);
  qInp .addEventListener('input',  applyFilters);

  // ——— Initial state
  repopulateCourses('');
  applyFilters();
});
</script>



