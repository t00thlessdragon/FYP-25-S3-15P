@model FYP_25_S3_15P.ViewModels.CatalogVm
@{
    Layout = "~/Views/Shared/_UALayout.cshtml";
    ViewData["Title"] = "Catalog";
}

<section class="container-wide card-xl">
  <div class="card rounded-4 p-4 p-lg-5 shadow-lg border-0">

    <!-- Page header: title + template CSV split button + upload button -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
      <h2 class="mb-0">Catalog</h2>

      <div class="d-flex align-items-center gap-2">
        <!-- Template CSV -->
        <div class="btn-group">
          <span class="btn btn-outline-secondary disabled text-muted pe-none" aria-disabled="true">
            <i class="bi bi-file-earmark-text me-1"></i> Template CSV
          </span>

          <!-- Actual dropdown trigger for choosing which CSV template to download -->
          <button
            type="button"
            class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Choose CSV template">
            <span class="visually-hidden">Toggle Dropdown</span>
          </button>

          <!-- Menu items map to server actions that return CSVs -->
          <ul class="dropdown-menu dropdown-menu-end">
            <li>
              <a
                class="dropdown-item"
                href="@Url.Action("TemplateCsv","UADashboard", new { kind = "programs" })">
                programs.csv
              </a>
            </li>
            <li>
              <a
                class="dropdown-item"
                href="@Url.Action("TemplateCsv","UADashboard", new { kind = "courses" })">
                courses.csv
              </a>
            </li>
            <li>
              <a
                class="dropdown-item"
                href="@Url.Action("TemplateCsv","UADashboard", new { kind = "modules" })">
                modules.csv
              </a>
            </li>
          </ul>
        </div>

        <!-- Upload CSV -->
        <button class="btn btn-primary" id="btnUploadCsv">
          <i class="bi bi-upload me-1"></i> Upload CSV
        </button>
        <input id="csvFiles" type="file" accept=".csv" multiple class="d-none" />
      </div>
    </div>

    <!-- Toolbar with 3 filters: Program, Course, and text search -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
      <!-- Program -->
      <div class="flex-fill" style="min-width:220px;">
        <select id="fltProgram" class="form-select">
          <option value="">Program: All</option>
          @foreach (var p in Model.Programs)
          {
            <option value="@p.Code">@p.Code – @p.Name</option>
          }
        </select>
      </div>

      <!-- Course -->
      <div class="flex-fill" style="min-width:220px;">
        <select id="fltCourse" class="form-select">
          <option value="">Course: All</option>
          @foreach (var c in Model.Courses)
          {
            <option value="@c.Code" data-program="@c.ProgramCode">@c.Code – @c.Name</option>
          }
        </select>
      </div>

      <!-- Search -->
      <div class="flex-fill" style="min-width:220px;">
        <input id="fltSearch" class="form-control" placeholder="Search code/name…">
      </div>
    </div>

    <div class="row g-3">
      <!-- Programs Card-->
      <div class="col-12 col-lg-4">
        <div class="card rounded-4 shadow-lg h-100 border-0">
          <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center border-0">
            <span>Programs</span>
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
              <!--
                <li>
                  <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#mdlCreateProgram">Create Program</a>
                </li>
                <li>
                  <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#mdlSelectProgram">Update Program</a>
                </li>
                -->
                <li>
                  <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#mdlSelectProgramDelete">Delete Program</a>
                </li>
              </ul>
            </div>
          </div>

          <div class="card-body p-3">
            <div id="listPrograms" class="list-group list-group-flush" style="max-height:60vh; overflow:auto;">
              @foreach (var p in Model.Programs)
              {
                <button
                  type="button"
                  class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                  data-code="@p.Code"
                  data-name="@p.Name">
                  <span>
                    <span class="badge bg-secondary me-2">@p.Code</span> @p.Name
                  </span>
                </button>
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Courses Card -->
      <div class="col-12 col-lg-4">
        <div class="card rounded-4 shadow-lg h-100 border-0">
          <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center border-0">
            <span>Courses</span>
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
              <!--
                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#mdlCreateCourse">Create Course</a></li>
                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#mdlUpdateCourse">Update Course</a></li>
                -->
                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#mdlDeleteCourse">Delete Course</a></li>
              </ul>
            </div>
          </div>

          <div class="card-body p-3">
            <div id="listCourses" class="list-group list-group-flush" style="max-height:60vh; overflow:auto;">
              @foreach (var c in Model.Courses)
              {
                <button
                  type="button"
                  class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                  data-code="@c.Code"
                  data-name="@c.Name"
                  data-program="@c.ProgramCode">
                  <span>
                    <span class="badge bg-secondary me-2">@c.Code</span> @c.Name
                  </span>
                </button>
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Modules Card-->
      <div class="col-12 col-lg-4">
        <div class="card rounded-4 shadow-lg h-100 border-0">
          <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center border-0">
            <span>Modules</span>
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots-vertical"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
              <!--
                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#mdlCreateModule">Create Module</a></li>
                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#mdlUpdateModule">Update Module</a></li>
                -->
                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#mdlDeleteModule">Delete Module</a></li>
                <li><hr class="dropdown-divider" /></li>
              </ul>
            </div>
          </div>

          <div class="card-body p-3">
            <div id="listModules" class="list-group list-group-flush" style="max-height:60vh; overflow:auto;">
              @foreach (var m in Model.Modules)
              {
                <button
                  type="button"
                  class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                  data-code="@m.Code"
                  data-name="@m.Name"
                  data-courses='@string.Join("|", m.CourseCodes ?? new List<string>())'>
                  <span>
                    <span class="badge bg-secondary me-2">@m.Code</span> @m.Name
                  </span>
                </button>
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer status -->
    <div class="d-flex justify-content-between small text-muted mt-4">
      <div>
        Showing Programs @Model.Programs.Count • Courses @Model.Courses.Count • Modules @Model.Modules.Count
      </div>
    </div>

  </div>
</section>

<!-- Create Program -->
<div class="modal fade" id="mdlCreateProgram" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content needs-validation" method="post" action="/UADashboard/CreateProgram" novalidate autocomplete="off">
      @Html.AntiForgeryToken()

      <div class="modal-header">
        <h5 class="modal-title fw-semibold">Create Program</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        @{
          var cpId   = (TempData["Form.CreateProgram.ProgramID"]   as string) ?? "";
          var cpCode = (TempData["Form.CreateProgram.ProgramCode"] as string) ?? "";
          var cpName = (TempData["Form.CreateProgram.ProgramName"] as string) ?? "";

          var peId   = TempData["Err.CreateProgram.ProgramID"]   as string;
          var peCode = TempData["Err.CreateProgram.ProgramCode"] as string;
          var peName = TempData["Err.CreateProgram.ProgramName"] as string;
        }

        <div class="mb-3">
          <label class="form-label">Program ID</label>
          <input
            name="ProgramID"
            id="ProgramID_Create"
            type="number"
            min="1"
            class="form-control @(peId!=null ? "is-invalid" : "")"
            value="@cpId"
            required />
          <div class="form-text">Numeric ID (unique per university)</div>
          <div class="invalid-feedback @(peId!=null ? "d-block" : "")">@peId</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Program Code</label>
          <input
            name="ProgramCode"
            id="ProgramCode_Create"
            class="form-control @(peCode!=null ? "is-invalid" : "")"
            placeholder="e.g., IT"
            pattern="^[A-Z0-9\-]+$"
            value="@cpCode"
            required />
          <div class="form-text">
            <i class="bi bi-info-circle me-1"></i> Codes are unique, <strong>UPPERCASE</strong>
          </div>
          <div class="invalid-feedback @(peCode!=null ? "d-block" : "")">@peCode</div>
        </div>

        <div class="mb-1">
          <label class="form-label">Program Name</label>
          <input
            name="ProgramName"
            class="form-control @(peName!=null ? "is-invalid" : "")"
            value="@cpName"
            placeholder="e.g., Information Technology"
            required />
          <div class="invalid-feedback @(peName!=null ? "d-block" : "")">@peName</div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Create Course -->
<div class="modal fade" id="mdlCreateCourse" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content needs-validation" method="post" action="/UADashboard/CreateCourse" novalidate autocomplete="off">
      @Html.AntiForgeryToken()

      <div class="modal-header">
        <h5 class="modal-title fw-semibold">Create Course</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        @{
          var ccId   = (TempData["Form.CreateCourse.CourseID"]   as string) ?? "";
          var ccCode = (TempData["Form.CreateCourse.CourseCode"] as string) ?? "";
          var ccName = (TempData["Form.CreateCourse.CourseName"] as string) ?? "";
          var ccProg = (TempData["Form.CreateCourse.ProgramCode"] as string) ?? "";

          var ceId   = TempData["Err.CreateCourse.CourseID"]   as string;
          var ceCode = TempData["Err.CreateCourse.CourseCode"] as string;
          var ceName = TempData["Err.CreateCourse.CourseName"] as string;
          var ceProg = TempData["Err.CreateCourse.ProgramCode"] as string;
        }

        <div class="mb-3">
          <label class="form-label">Course ID</label>
          <input
            name="CourseID"
            type="number"
            min="1"
            class="form-control @(ceId!=null ? "is-invalid" : "")"
            value="@ccId"
            required />
          <div class="form-text">Numeric ID (unique per university)</div>
          <div class="invalid-feedback @(ceId!=null ? "d-block" : "")">@ceId</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Course Code</label>
          <input
            name="CourseCode"
            id="CourseCode_Create"
            class="form-control @(ceCode!=null ? "is-invalid" : "")"
            placeholder="e.g., CSIT-BD"
            pattern="^[A-Z0-9\-]+$"
            value="@ccCode"
            required />
          <div class="form-text">
            <i class="bi bi-info-circle me-1"></i> Codes are unique, <strong>UPPERCASE</strong>
          </div>
          <div class="invalid-feedback @(ceCode!=null ? "d-block" : "")">@ceCode</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Course Name</label>
          <input
            name="CourseName"
            class="form-control @(ceName!=null ? "is-invalid" : "")"
            value="@ccName"
            placeholder="e.g., Computer Science (Big Data)"
            required />
          <div class="invalid-feedback @(ceName!=null ? "d-block" : "")">@ceName</div>
        </div>

        <div class="mb-1">
          <label class="form-label">Program</label>
          <div
            id="progList_Create"
            class="list-group border rounded @((ceProg!=null ? "border-danger" : ""))"
            style="max-height:260px; overflow:auto;">

            <!-- sticky search inside the list -->
            <div class="list-group-item search-row bg-light position-sticky top-0" style="z-index:1;">
              <input id="progSearch_Create" class="form-control form-control-sm" placeholder="Search programs…">
            </div>

            @for (int i = 0; i < Model.Programs.Count; i++)
            {
              var p = Model.Programs[i];
              var isChecked = string.Equals(ccProg, p.Code, StringComparison.OrdinalIgnoreCase);
              <label
                class="list-group-item program-item d-flex align-items-center gap-2"
                data-code="@p.Code"
                data-name="@p.Name"
                data-idx="@i">
                <input
                  type="radio"
                  class="form-check-input"
                  name="ProgramCode"
                  value="@p.Code"
                  @(isChecked ? "checked" : "")
                  @(i == 0 ? "required" : "") />
                <span><span class="badge bg-secondary me-2">@p.Code</span>@p.Name</span>
              </label>
            }
          </div>

          <div class="invalid-feedback d-block @(ceProg!=null ? "" : "visually-hidden")">@ceProg</div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Create Module -->
<div class="modal fade" id="mdlCreateModule" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <form class="modal-content needs-validation" method="post" action="/UADashboard/CreateModule" novalidate autocomplete="off">
      @Html.AntiForgeryToken()

      <div class="modal-header">
        <h5 class="modal-title fw-semibold">Create Module</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      @{
        var cmId   = (TempData["Form.CreateModule.ModuleID"]   as string) ?? "";
        var cmCode = (TempData["Form.CreateModule.ModuleCode"] as string) ?? "";
        var cmName = (TempData["Form.CreateModule.ModuleName"] as string) ?? "";

        var ceId   = TempData["Err.CreateModule.ModuleID"]    as string;
        var ceCode = TempData["Err.CreateModule.ModuleCode"]  as string;
        var ceName = TempData["Err.CreateModule.ModuleName"]  as string;
        var ceCc   = TempData["Err.CreateModule.CourseCodes"] as string;
      }

      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Module ID</label>
          <input
            name="ModuleID"
            id="ModuleID_Create"
            type="number"
            min="1"
            class="form-control @(ceId!=null ? "is-invalid" : "")"
            value="@cmId"
            required />
          <div class="form-text">Numeric ID (unique globally)</div>
          <div class="invalid-feedback @(ceId!=null ? "d-block" : "")">@ceId</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Module Code</label>
          <input
            name="ModuleCode"
            id="ModuleCode_Create"
            class="form-control @(ceCode!=null ? "is-invalid" : "")"
            placeholder="e.g., CSCI316"
            pattern="^[A-Z0-9\-]+$"
            value="@cmCode"
            required />
          <div class="form-text">
            <i class="bi bi-info-circle me-1"></i> Codes are unique, <strong>UPPERCASE</strong>
          </div>
          <div class="invalid-feedback @(ceCode!=null ? "d-block" : "")">@ceCode</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Module Name</label>
          <input
            name="ModuleName"
            id="ModuleName_Create"
            class="form-control @(ceName!=null ? "is-invalid" : "")"
            value="@cmName"
            placeholder="e.g., Big Data Mining"
            required />
          <div class="invalid-feedback @(ceName!=null ? "d-block" : "")">@ceName</div>
        </div>

        <div class="mb-1">
          <label class="form-label">Courses</label>
          <div
            id="courseList_Create"
            class="list-group border rounded @((ceCc!=null ? "border-danger" : ""))"
            style="max-height:260px; overflow:auto;">

            <div class="list-group-item search-row bg-light position-sticky top-0" style="z-index:1;">
              <input id="courseSearch_Create" class="form-control form-control-sm" placeholder="Search courses…">
            </div>

            @for (int i = 0; i < Model.Courses.Count; i++)
            {
              var c = Model.Courses[i];
              <label
                class="list-group-item course-item d-flex align-items-center gap-2"
                data-code="@c.Code"
                data-name="@c.Name"
                data-idx="@i">
                <input type="checkbox" class="form-check-input" name="CourseCodes" value="@c.Code" />
                <span><span class="badge bg-secondary me-2">@c.Code</span>@c.Name</span>
              </label>
            }
          </div>

          <div class="invalid-feedback d-block @(ceCc!=null ? "" : "visually-hidden")">@ceCc</div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Update Program -->
<div class="modal fade" id="mdlUpdateProgram" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content needs-validation" method="post" action="/UADashboard/UpdateProgram" novalidate>
      @Html.AntiForgeryToken()

      <div class="modal-header">
        <h5 class="modal-title fw-semibold">Update Program</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        @{
          var upCode = (TempData["Form.UpdateProgram.ProgramCode"] as string) ?? "";
          var upName = (TempData["Form.UpdateProgram.ProgramName"] as string) ?? "";

          var ueCode = TempData["Err.UpdateProgram.ProgramCode"] as string;
          var ueName = TempData["Err.UpdateProgram.ProgramName"] as string;
        }

        <div class="mb-3">
          <label class="form-label">Program Code</label>
          <input
            name="ProgramCode"
            id="ProgramCode_Update"
            class="form-control @(ueCode!=null ? "is-invalid" : "")"
            value="@upCode"
            readonly />
          <div class="invalid-feedback @(ueCode!=null ? "d-block" : "")">@ueCode</div>
          <div class="form-text text-muted">(read-only)</div>
        </div>

        <div class="mb-1">
          <label class="form-label">Program Name</label>
          <input
            name="ProgramName"
            id="ProgramName_Update"
            class="form-control @(ueName!=null ? "is-invalid" : "")"
            value="@upName"
            required />
          <div class="invalid-feedback @(ueName!=null ? "d-block" : "")">@ueName</div>
        </div>
      </div>

      <div class="modal-footer justify-content-between">
        <button
          type="button"
          class="btn btn-outline-danger"
          data-bs-target="#mdlDeleteProgram"
          data-bs-toggle="modal">
          Delete
        </button>
        <div>
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </div>
    </form>
  </div>
</div>

