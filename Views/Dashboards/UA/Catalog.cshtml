@{
  // TempData values from controller (used for toast + modal reopen)
    var toastMsg   = TempData["Toast"] as string;
    var toastLevel = (TempData["ToastLevel"] as string) ?? "info"; 
    var reopenId   = TempData["ReopenModal"] as string;
}
@if (!string.IsNullOrWhiteSpace(toastMsg))
{
   //Toast notification at top-right
  <div class="position-fixed top-0 end-0 p-3" style="z-index:1080">
    <div id="mainToast" class="toast align-items-center text-bg-@toastLevel border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">@toastMsg</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>
  //Auto-show toast after DOM is loaded
  <script>
    document.addEventListener('DOMContentLoaded', function(){
      var t = document.getElementById('mainToast');
      if (t) new bootstrap.Toast(t, { delay: 6000 }).show();
    });
  </script>
}
@if (!string.IsNullOrWhiteSpace(reopenId))
// Reopen modal automatically if controller asked for it (e.g. validation fail)
{
  <script>
    document.addEventListener('DOMContentLoaded', function(){
      var m = document.getElementById('@reopenId');
      if (m) new bootstrap.Modal(m).show();
    });
  </script>
}


@section Scripts {
<script>
// ---------- Auto-UPPERCASE for code fields ----------
["ProgramCode_Create","CourseCode_Create","ModuleCode_Create"].forEach(id=>{
  const el = document.getElementById(id);
  if (el) el.addEventListener("input", () => { el.value = el.value.toUpperCase(); });
});

// ---------- Bootstrap client-side validation ----------
(() => {
  const forms = document.querySelectorAll('.needs-validation');
  Array.from(forms).forEach(form => {
    form.addEventListener('submit', (event) => {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);
  });
})();
</script>

<script>
// Selectors + Update flow
// Retarget update menu items to open SELECT modals
document.addEventListener('DOMContentLoaded', () => {
  const retarget = (selector, newTargetId) => {
    document.querySelectorAll(selector).forEach(a => {
      a.setAttribute('data-bs-target', `#${newTargetId}`);
      a.setAttribute('href', '#'); 
    });
  };
  
  retarget('a[data-bs-target="#mdlUpdateCourse"]',  'mdlSelectCourse');
  retarget('a[data-bs-target="#mdlUpdateModule"]',  'mdlSelectModule');
});

// Enforce single-select checkboxes
function enableSingleSelect(selector) {
  document.querySelectorAll(selector).forEach(cb=>{
    cb.addEventListener('change', ()=> {
      if (cb.checked) {
        document.querySelectorAll(selector).forEach(o => { if (o!==cb) o.checked = false; });
      }
    });
  });
}
enableSingleSelect('.single-program');
enableSingleSelect('.single-course');
enableSingleSelect('.single-module');

 // Simple search filter
function attachFilter(inputId, listSelector){
  const q = document.getElementById(inputId);
  if (!q) return;
  q.addEventListener('input', ()=>{
    const term = q.value.toLowerCase();
    document.querySelectorAll(listSelector+' .list-group-item').forEach(li=>{
      const txt = li.innerText.toLowerCase();
      li.style.display = txt.includes(term) ? '' : 'none';
    });
  });
}
attachFilter('searchProgramUpd', '#listProgramUpd');
attachFilter('searchCourseUpd',  '#listCourseUpd');
attachFilter('searchModuleUpd',  '#listModuleUpd');

// Hide whichever modal is showing
function hideOpenModal() {
  const shown = document.querySelector('.modal.show');
  if (shown) {
    const inst = bootstrap.Modal.getInstance(shown);
    if (inst) inst.hide();
  }
}

// Confirm update handlers

// Program
document.getElementById('confirmProgramUpd')?.addEventListener('click', ()=>{
  const chosen = Array.from(document.querySelectorAll('.single-program')).find(x=>x.checked);
  if (!chosen) return alert('Please select a program.');
  document.getElementById('ProgramCode_Update').value = chosen.value || '';
  document.getElementById('ProgramName_Update').value = chosen.dataset.name || '';
  hideOpenModal();
  new bootstrap.Modal(document.getElementById('mdlUpdateProgram')).show();
});

// Course
document.getElementById('confirmCourseUpd')?.addEventListener('click', ()=>{
  const chosen = Array.from(document.querySelectorAll('.single-course')).find(x=>x.checked);
  if (!chosen) return alert('Please select a course.');
  document.getElementById('CourseCode_Update').value = chosen.value || '';
  document.getElementById('CourseName_Update').value = chosen.dataset.name || '';
  document.getElementById('CourseID_Update').value   = chosen.dataset.courseid || '';
  hideOpenModal();
  new bootstrap.Modal(document.getElementById('mdlUpdateCourse')).show();
});

</script>

<script>
// Helpers for Delete flows
if (typeof attachFilter !== 'function') {
  window.attachFilter = function(inputId, listSelector){
    const q = document.getElementById(inputId);
    if (!q) return;
    q.addEventListener('input', ()=>{
      const term = q.value.toLowerCase();
      document.querySelectorAll(listSelector+' .list-group-item').forEach(li=>{
        const txt = li.innerText.toLowerCase();
        li.style.display = txt.includes(term) ? '' : 'none';
      });
    });
  };
}
function singleSelect(className){
  document.querySelectorAll('.'+className).forEach(cb=>{
    cb.addEventListener('change', ()=>{
      if (cb.checked) {
        document.querySelectorAll('.'+className).forEach(o=>{ if(o!==cb) o.checked=false; });
      }
    });
  });
}

 // Retarget delete links to select modals
document.addEventListener('DOMContentLoaded', ()=>{
  // Programs
  document.querySelectorAll('a[data-bs-target="#mdlDeleteProgram"]').forEach(a=>{
    a.setAttribute('data-bs-target', '#mdlSelectProgramDelete'); a.href = '#';
  });
  // Courses
  document.querySelectorAll('a[data-bs-target="#mdlDeleteCourse"]').forEach(a=>{
    a.setAttribute('data-bs-target', '#mdlSelectCourseDelete'); a.href = '#';
  });
  // Modules
  document.querySelectorAll('a[data-bs-target="#mdlDeleteModule"]').forEach(a=>{
    a.setAttribute('data-bs-target', '#mdlSelectModuleDelete'); a.href = '#';
  });
});

// Attach search + single select for delete lists
attachFilter('searchProgramDel', '#listProgramDel');
attachFilter('searchCourseDel',  '#listCourseDel');
attachFilter('searchModuleDel',  '#listModuleDel');

singleSelect('del-program');
singleSelect('del-course');
singleSelect('del-module');

// Confirm delete handlers
document.getElementById('nextDeleteProgram')?.addEventListener('click', ()=>{
  const chosen = Array.from(document.querySelectorAll('.del-program')).find(x=>x.checked);
  if (!chosen) return alert('Please select a program.');
  const code = chosen.value, name = chosen.dataset.name || '';
  document.getElementById('ProgramCode_DeleteHidden').value = code;
