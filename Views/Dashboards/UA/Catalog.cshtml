                  name="ProgramCode"
                  value="@p.Code"
                  @(isChecked ? "checked" : "")
                  @(i == 0 ? "required" : "") />
                <span><span class="badge bg-secondary me-2">@p.Code</span>@p.Name</span>
              </label>
