        data-type="Staff"
        data-identifier="@(s.StaffID ?? "")"
        data-name="@(s.Name?.Trim() ?? "")"
        data-email="@(s.Email?.Trim() ?? "")"
        data-university="@(s.UniAbbrv ?? "")"
        data-status="@(s.Status ?? "")"
        data-lastlogin="@(s.LastLogin?.ToString("g") ?? "-")"
        data-active="@(!s.IsLocked)"
        data-program=""
        data-course=""
        data-session="@(s.SessionNo ?? "")"
        data-modules="@(string.Join(", ", s.AssignedModules.Select(m => m.ModuleCode)))">
        View / Edit
    </button>

</li>

</ul>

</div>

</td>

</tr>

}

@if (!staffList.Any())

{

<tr>

<td colspan="9" class="text-center text-muted fst-italic py-4">No staff records found for your university.</td>

</tr>

}

</tbody>

</table>

</div>

</div>





<div class="tab-pane fade" id="student-management" role="tabpanel" aria-labelledby="student-tab">

<div class="table-responsive overflow-visible">

<table class="table align-middle">

<thead class="table-dark">

<tr>

<th style="width:64px;">No.</th>

<th>Student ID</th>

<th>Name</th>

<th>Email</th>

<th>Program / Course</th>

