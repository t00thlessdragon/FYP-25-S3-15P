@section Scripts{
<script>

// Global function to handle form submission via fetch (for file uploads)

// The previous implementation was incomplete, this completes it for robustness.
function handleFormSubmit(event) {
    event.preventDefault();

    var form = event.target;
    var formData = new FormData(form);
    var submitButton = $(form).find('button[type="submit"]');
    var originalText = submitButton.data('original-text') || 'Upload';
    
    // Get a reference to the specific upload modal that is currently open
    var currentUploadModal = $(form).closest('.modal'); 

    // Show processing state
    submitButton.attr('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...');

    // Clear and show the generic success modal immediately
    $('#uploadSuccessModalLabel').text('Processing Upload...');
    $('#uploadSuccessMessage').text('Your file is being processed. Please wait...');
    // IMPORTANT: Use the Bootstrap 5 method to show the modal
    var uploadSuccessModalInstance = new bootstrap.Modal(document.getElementById('uploadSuccessModal'));
    uploadSuccessModalInstance.show();


    // Perform the actual upload via fetch
    fetch(form.action, {
        method: form.method,
        body: formData,
    })
    .then(response => {
        // Check for success status codes (2xx) and handle response type
        if (!response.ok) {
            return response.text().then(text => { throw new Error(text || response.statusText); });
        }
        // Assuming successful uploads return JSON
        return response.json();
    })
    .then(data => {
        // Update modal with results
        $('#uploadSuccessModalLabel').text(data.success ? 'Upload Complete' : 'Upload Failed');
        $('#uploadSuccessMessage').html(data.message || 'Check server logs for details.');

        // 🌟 FIX: Explicitly hide the upload modal after the result is received
        // This ensures the success modal is the only one visible.
        var uploadModalInstance = bootstrap.Modal.getInstance(currentUploadModal[0]);
        if (uploadModalInstance) {
            uploadModalInstance.hide();
        }

        if (data.success) {
            // Reload page after a short delay to display new users
            setTimeout(() => window.location.reload(), 3000);
        }
    })
    .catch(error => {
        // Handle network errors or non-200 responses
        $('#uploadSuccessModalLabel').text('Upload Error');
        $('#uploadSuccessMessage').html('An unexpected error occurred: ' + error.message);
        console.error('Upload Error:', error);
    })
    .finally(() => {
        // Reset button state if the page didn't reload (e.g., in case of error)
        submitButton.attr('disabled', false).html(originalText);
    });

    return false;
}


$(document).ready(function () {

// Cache jQuery selectors for performance

const $viewUserModal = $('#viewUserModal');

const $confirmDeactivateModal = $('#confirmDeactivateModal');

const $toggleActiveBtn = $('#modal-toggle-active-btn');

const $resetPasswordBtn = $('#modal-reset-password-btn');

const $deactivateProfileIdInput = $('#deactivate-profileId-input');

const $deactivateValueInput = $('#deactivate-value-input');

const $deactivateUserName = $('#deactivate-user-name');

const $deactivateActionText = $('#deactivate-action-text');

const $deactivateWarningText = $('#deactivate-warning-text');

const $deactivateSubmitBtn = $('#deactivate-submit-btn');

const $deactivateModalHeader = $('#deactivate-modal-header');



const $resetProfileIdInput = $('#reset-profileId-input');

const $resetUserName = $('#reset-user-name');


// 1. Logic for populating the View/Edit Modal

$viewUserModal.on('show.bs.modal', function (event) {

    const button = $(event.relatedTarget); // Button that triggered the modal

    // Collect data attributes from the button
    const userId = button.data('id');
    const userType = button.data('type');
    const identifier = button.data('identifier');
    const name = button.data('name');
    const email = button.data('email');
    const university = button.data('university');
    const status = button.data('status');
    const lastlogin = button.data('lastlogin');
    const isActive = String(button.data('active')).toLowerCase() === 'true';
    const program = button.data('program');
    const course = button.data('course');
    const session = button.data('session');
    const modules = button.data('modules');


    // Populate View Modal fields (WITH CRITICAL FALLBACKS)
    $('#modal-user-type').text(userType || 'N/A'); // Added Fallback
    $('#modal-identifier').text(identifier || 'N/A'); // Added Fallback
    $('#modal-status').text(status || '-');

    $('#modal-name').text(name || 'N/A'); // <--- FIX APPLIED
    $('#modal-email').text(email || '-'); // <--- FIX APPLIED
    $('#modal-university').text(university || '-'); // <--- FIX APPLIED
    $('#modal-session').text(session || '-'); // <--- FIX APPLIED
    $('#modal-last-login').text(lastlogin || '-'); // <--- FIX APPLIED


    // Modules Logic with Fallback for an empty module list
    const moduleContent = modules && modules.trim() !== "" 
        ? modules.split(', ').map(m => `<span class="badge bg-secondary me-1">${m}</span>`).join(' ')
        : '-';
        
    $('#modal-modules').html(moduleContent);
    $('#modal-modules-label').text(userType === 'Staff' ? 'Assigned Modules' : 'Enrolled Modules');


    // Toggle student-specific fields (also requires fallbacks for clarity)
    if (userType === 'Student') {
        $('.modal-student-details').show();
        $('#modal-program').text(program || '-');
        $('#modal-course').text(course || '-');
    } else {
        $('.modal-student-details').hide();
    }



// ==========================================================

// 2. CRITICAL: Set up the Deactivate/Activate Button in View Modal

// ==========================================================

const actionText = isActive ? 'Deactivate' : 'Activate';

const actionClass = isActive ? 'btn-danger' : 'btn-success';



// Set the button text and class dynamically

$toggleActiveBtn

.text(actionText)

.removeClass('btn-danger btn-success')

.addClass(actionClass)

// Set data attributes on the toggle button for use by the confirmation modal

.data('user-id', userId)

.data('user-name', name)

.data('is-active', isActive)

.data('profile-type', userType);


// Set data attributes on the reset password button

$resetPasswordBtn

.data('user-id', userId)

.data('user-name', name)

.data('profile-type', userType);

});



// 3. Logic for populating the Deactivate/Activate Confirmation Modal

$confirmDeactivateModal.on('show.bs.modal', function (event) {

const button = $(event.relatedTarget); // The toggle button from the main view modal


const userId = button.data('user-id');

const name = button.data('user-name');

const currentlyActive = button.data('is-active');

const profileType = button.data('profile-type');


// Determine the *target* state we are submitting:

const targetValue = !currentlyActive; // true to Activate, false to Deactivate

const action = targetValue ? 'ACTIVATE' : 'DEACTIVATE';

const buttonText = targetValue ? 'Confirm Activate' : 'Confirm Deactivate';

const headerClass = targetValue ? 'bg-success' : 'bg-danger';

const submitClass = targetValue ? 'btn-success' : 'btn-danger';

const warningText = targetValue

? 'The user will be able to log in again.'

: 'The user will be locked out of the system until reactivated.';

const warningTextColor = targetValue ? 'text-success small' : 'text-danger small';


// *** CRITICAL FIX: Populate hidden form fields ***

// This ensures profileId is NOT null when posting to the controller.

$deactivateProfileIdInput.val(userId);

$deactivateValueInput.val(targetValue);

// The controller parameter is 'value', which is a bool, so we pass 'true' or 'false' string.



// Populate confirmation modal text/styling

$deactivateUserName.text(name);

$deactivateActionText.text(action);

$deactivateSubmitBtn.text(buttonText).removeClass('btn-danger btn-success').addClass(submitClass);

$deactivateModalHeader.removeClass('bg-danger bg-success').addClass(headerClass);

$deactivateWarningText.text(warningText).removeClass('text-danger text-success').addClass(warningTextColor);

});


// 4. Logic for populating the Reset Password Confirmation Modal

$('#confirmResetPasswordModal').on('show.bs.modal', function (event) {

const button = $(event.relatedTarget);

const userId = button.data('user-id');

const name = button.data('user-name');


// Populate hidden form field

$resetProfileIdInput.val(userId);


// Populate modal display text

$resetUserName.text(name);

});

});



</script>
}