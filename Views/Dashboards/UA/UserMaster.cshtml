@using Microsoft.AspNetCore.Mvc.TagHelpers
@model FYP_25_S3_15P.Models.StaffAndStudentVm



@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers



@{

ViewData["Title"] = "University User Management Dashboard";



// Model updated to use StaffAndStudentVm

var staffList = Model.Staff ?? new List<FYP_25_S3_15P.Models.StaffAndStudentVm.StaffRow>();

var studentList = Model.Students ?? new List<FYP_25_S3_15P.Models.StaffAndStudentVm.StudentRow>();

}





<style>

.overflow-visible { overflow: visible !important; }

.table .dropdown-menu { z-index: 1060; }

.modal-staff-details {

display: none;

}

/* Ensure modals are on top of other content */

.modal { z-index: 2000; }

.modal-backdrop { z-index: 1999; }

#uploadSuccessModal { z-index: 2010; }

</style>





<section class="card-xl container-wide">

<div class="card rounded-4 p-4 p-lg-5 shadow-lg">

<div class="d-flex justify-content-between align-items-center mb-3">

<h2 class="mb-0">University User Management</h2>

<div class="dropdown">

<button class="btn btn-primary dropdown-toggle shadow-sm" type="button" id="uploadUsersDropdown" data-bs-toggle="dropdown" aria-expanded="false">

+ Upload Users

</button>

<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="uploadUsersDropdown">

<li><button class="dropdown-item text-decoration-underline fw-semibold" data-bs-toggle="modal" data-bs-target="#uploadStaffModal">+ Upload Staff</button></li>

<li><button class="dropdown-item text-decoration-underline fw-semibold" data-bs-toggle="modal" data-bs-target="#uploadStudentsModal">+ Upload Students</button></li>

</ul>

</div>

</div>



@* Flash Messages *@

@if (TempData["Flash"] is string ok && !string.IsNullOrWhiteSpace(ok))

{

<div class="alert alert-success alert-dismissible fade show" role="alert">@ok

<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

</div>

}

@if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))

{

<div class="alert alert-danger alert-dismissible fade show" role="alert">@err

<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

</div>

}



<ul class="nav nav-tabs mb-4" id="userTabs" role="tablist">

<li class="nav-item" role="presentation">

<button class="nav-link active" id="staff-tab" data-bs-toggle="tab" data-bs-target="#staff-management" type="button" role="tab" aria-controls="staff-management" aria-selected="true">

Staff Management (@staffList.Count)

</button>

</li>

<li class="nav-item" role="presentation">

<button class="nav-link" id="student-tab" data-bs-toggle="tab" data-bs-target="#student-management" type="button" role="tab" aria-controls="student-management" aria-selected="false">

Student Management (@studentList.Count)

</button>

</li>

</ul>



<div class="tab-content" id="userTabsContent">



<div class="tab-pane fade show active" id="staff-management" role="tabpanel" aria-labelledby="staff-tab">

<div class="table-responsive overflow-visible">

<table class="table align-middle">

<thead class="table-dark">

<tr>

<th style="width:64px;">No.</th>

<th>Staff ID</th>

<th>Name</th>

<th>Email</th>

<th>Modules</th>

<th>Session</th>

<th>Status</th>

<th>Last Login</th>

<th class="text-end" style="width:80px;">Action</th>

</tr>

</thead>

<tbody>

@for (var i = 0; i < staffList.Count; i++)

{

var s = staffList[i];

var badge = s.IsLocked ? "danger" :

(s.Status ?? "").ToLowerInvariant() == "active" ? "success" :

(s.Status ?? "").ToLowerInvariant() == "pending" ? "warning" : "secondary";



<tr>

<td class="text-muted">@(@i + 1)</td>

<td>@s.StaffID</td>

<td>@s.Name</td>

<td>@s.Email</td>

<td>

@foreach(var m in s.AssignedModules)

{

<span class="badge bg-secondary me-1">@m.ModuleCode</span>

}

</td>

<td>

<span>@s.SessionNo</span>

</td>

<td><span class="badge bg-@badge">@((s.IsLocked ? "Locked" : s.Status) ?? "-")</span></td>

<td>@(s.LastLogin?.ToString("g") ?? "-")</td>

<td class="text-end">

<div class="dropdown">

<button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown" aria-label="Row actions">

<i class="bi bi-three-dots-vertical fs-5"></i>

</button>

<ul class="dropdown-menu dropdown-menu-end">

<li>

<button class="dropdown-item view-user-btn" data-bs-toggle="modal" data-bs-target="#viewUserModal"
