@model FYP_25_S3_15P.Models.FYPTemplateMaster
@{
    ViewData["Title"] = "Project Template Dashboard";
    var tab = Model.ActiveTab ?? "templates";
}


<section class="container-wide card-xl">
    <div class="card rounded-4 p-4 p-lg-5 shadow-lg">
        <h2 class="mb-4">Project Template Dashboard</h2>

        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item">
                <a class="nav-link @(tab=="templates"?"active":"")"
                   asp-controller="SCDashboard" asp-action="FYPTemplateMaster" asp-route-tab="templates">Template Management</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(tab=="uploadtemplates"?"active":"")"
                   asp-controller="SCDashboard" asp-action="FYPTemplateMaster" asp-route-tab="uploadtemplates">Upload Template</a>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade @(tab=="templates"?"show active":"")" id="tab-templates">
                @await Html.PartialAsync("~/Views/Dashboards/SC/_TemplateTab.cshtml", Model)
            </div>
            <div class="tab-pane fade @(tab=="uploadtemplates"?"show active":"")" id="tab-uploadTemplates">
                @await Html.PartialAsync("~/Views/Dashboards/SC/_UploadTemplateTab.cshtml", Model)
            </div>
        </div>
    </div>
</section>