@model FYP_25_S3_15P.Models.Course
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Update Course";
    Layout = "_UADashboardLayout";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Update Course</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "UADashboard")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ManageCourse", "UADashboard")">Manage Courses</a></li>
                    <li class="breadcrumb-item active">Update Course</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-action="UpdateCourse">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ID" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CourseID" class="form-label">Course ID</label>
                    <input asp-for="CourseID" class="form-control" required />
                    <span asp-validation-for="CourseID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CourseName" class="form-label">Course Name</label>
                    <input asp-for="CourseName" class="form-control" required />
                    <span asp-validation-for="CourseName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProgramID" class="form-label">Program</label>
                    <select asp-for="ProgramID" class="form-select" required>
                        <option value="">-- Select Program --</option>
                        @foreach (var program in ViewBag.Programs as List<FYP_25_S3_15P.Models.Programs>)
                        {
                            <option value="@program.ProgramID">@program.ProgramName</option>
                        }
                    </select>
                    <span asp-validation-for="ProgramID" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        Update Course
                    </button>
                    <a href="@Url.Action("ViewCourse", "UADashboard", new { id = Model.ID })" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}