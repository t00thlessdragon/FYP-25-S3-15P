@model FYP_25_S3_15P.ViewModels.UserDetailVm

@{
    ViewData["Title"] = "User Details";
    Layout = "_UADashboardLayout";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>User Details</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "UADashboard")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ManageUsersList", "UADashboard")">Manage Users</a></li>
                    <li class="breadcrumb-item active">User Details</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@Model.Name</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Name:</strong> @Model.Name</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Role:</strong> @Model.Role</p>
                </div>
                <div class="col-md-6">
                    <p><strong>University:</strong> @Model.UniversityName</p>
                    <p>
                        <strong>Status:</strong>
                        @if (Model.Status == "Disabled")
                        {
                            <span class="badge bg-danger">Disabled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                    </p>
                    <p><strong>Last Login:</strong> @(Model.LastLogin?.ToString("g") ?? "Never")</p>
                </div>
            </div>

            <hr />

            <div class="d-flex gap-2">
                <!-- Edit Button: Only for active users -->
                @if (Model.Status != "Disabled")
                {
                    <a href="@Url.Action("UpdateUserAccount", "UADashboard", new { id = Model.ID })" class="btn btn-primary">
                        Edit User
                    </a>

                    <form method="post" action="@Url.Action("DisableUserAccount", "UADashboard", new { id = Model.ID })" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to disable this user?');">
                            Disable User
                        </button>
                    </form>
                }

                <!-- Re-enable Button: Only for disabled users -->
                @if (Model.Status == "Disabled")
                {
                    <form method="post" action="@Url.Action("ReactivateUserAccount", "UADashboard", new { id = Model.ID })" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-unlock"></i> Re-enable User
                        </button>
                    </form>
                }

                <a href="@Url.Action("ManageUsersList", "UADashboard")" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>