@model FYP_25_S3_15P.ViewModels.UADashboardVm
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "University Admin Dashboard";
    Layout = "_UADashboardLayout";
    var name = Model?.AdminName ?? "Admin";
    var uniName = Model?.UniversityName ?? "University";
}

<section class="container-fluid py-4">
    <!-- Page title -->
    <h2 class="mb-3">Dashboard</h2>

    <!-- Welcome message -->
    <div class="fs-4 mb-2">Welcome, @name!</div>
    <div class="text-muted mb-4">@uniName</div>

    <!-- Info callout -->
    <div class="d-flex align-items-start gap-3 mb-4 p-3 rounded-3 border bg-light">
        <i class="bi bi-info-circle fs-4 text-secondary"></i>
        <div class="small text-muted">
            Manage your university's programs, courses, users, and system settings from this dashboard.
            Ensure all information is up-to-date and accurate.
        </div>
    </div>

    <!-- Cards grid -->
    <div class="row g-4">
        <!-- University Statistics -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <i class="bi bi-graph-up fs-2 text-dark"></i>
                        <div class="fw-semibold">University Statistics</div>
                    </div>
                    <ul class="mb-0">
                        <li>Total Users: <strong>@Model.TotalUsers</strong></li>
                        <li>Total Programs: <strong>@Model.TotalPrograms</strong></li>
                        <li>Total Courses: <strong>@Model.TotalCourses</strong></li>
                        <li>Total Experts: <strong>@Model.TotalExperts</strong></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <i class="bi bi-lightning-charge fs-2 text-dark"></i>
                        <div class="fw-semibold">Quick Actions</div>
                    </div>
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("CreateUserAccount", "UADashboard")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-person-plus"></i> Create New User
                        </a>
                        <a href="@Url.Action("CreateProgram", "UADashboard")" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-journal-plus"></i> Create New Program
                        </a>
                        <a href="@Url.Action("CreateCourse", "UADashboard")" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-book"></i> Create New Course
                        </a>
                        <a href="@Url.Action("SetUniversityConstraints", "UADashboard")" class="btn btn-outline-warning btn-sm">
                            <i class="bi bi-gear"></i> Set Constraint
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Functions -->
        <div class="col-12">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <i class="bi bi-gear fs-2 text-dark"></i>
                        <div class="fw-semibold">Management Functions</div>
                    </div>

                    <div class="row g-3">
                        <!-- Manage Profile -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <a href="@Url.Action("ViewProfile", "UADashboard")" class="text-decoration-none">
                                <div class="p-3 border rounded-3 h-100 hover-shadow">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-person-circle fs-4 text-primary"></i>
                                        <div class="fw-semibold">Manage Profile</div>
                                    </div>
                                    <p class="small text-muted mb-0">View and update your profile information</p>
                                </div>
                            </a>
                        </div>

                        <!-- Manage University -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <a href="@Url.Action("SetUniversityConstraints", "UADashboard")" class="text-decoration-none">
                                <div class="p-3 border rounded-3 h-100 hover-shadow">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-building fs-4 text-success"></i>
                                        <div class="fw-semibold">Manage University</div>
                                    </div>
                                    <p class="small text-muted mb-0">Configure university-wide constraints</p>
                                </div>
                            </a>
                        </div>

                        <!-- Manage Program -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <a href="@Url.Action("ManageProgram", "UADashboard")" class="text-decoration-none">
                                <div class="p-3 border rounded-3 h-100 hover-shadow">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-journals fs-4 text-info"></i>
                                        <div class="fw-semibold">Manage Program</div>
                                    </div>
                                    <p class="small text-muted mb-0">Create, view, and edit academic programs</p>
                                </div>
                            </a>
                        </div>

                        <!-- Manage Course -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <a href="@Url.Action("ManageCourse", "UADashboard")" class="text-decoration-none">
                                <div class="p-3 border rounded-3 h-100 hover-shadow">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-book fs-4 text-warning"></i>
                                        <div class="fw-semibold">Manage Course</div>
                                    </div>
                                    <p class="small text-muted mb-0">Manage courses and curriculum</p>
                                </div>
                            </a>
                        </div>

                        <!-- Manage Users -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <a href="@Url.Action("ManageUsersList", "UADashboard")" class="text-decoration-none">
                                <div class="p-3 border rounded-3 h-100 hover-shadow">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-people fs-4 text-danger"></i>
                                        <div class="fw-semibold">Manage Users</div>
                                    </div>
                                    <p class="small text-muted mb-0">Manage user accounts and permissions</p>
                                </div>
                            </a>
                        </div>

                        <!-- Manage Expertise -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <a href="@Url.Action("ManageExpertise", "UADashboard")" class="text-decoration-none">
                                <div class="p-3 border rounded-3 h-100 hover-shadow">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-mortarboard fs-4 text-dark"></i>
                                        <div class="fw-semibold">Manage Expertise</div>
                                    </div>
                                    <p class="small text-muted mb-0">Manage staff expertise and specializations</p>
                                </div>
                            </a>
                        </div>

                        <!-- Manage Reports -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <a href="@Url.Action("ManageReports", "UADashboard")" class="text-decoration-none">
                                <div class="p-3 border rounded-3 h-100 hover-shadow">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-file-earmark-bar-graph fs-4 text-secondary"></i>
                                        <div class="fw-semibold">Manage Reports</div>
                                    </div>
                                    <p class="small text-muted mb-0">Generate and download system reports</p>
                                </div>
                            </a>
                        </div>

                        <!-- Platform Feedback -->
                        <div class="col-12 col-md-6 col-lg-4">
                            <a href="@Url.Action("ProvideFeedback", "UADashboard")" class="text-decoration-none">
                                <div class="p-3 border rounded-3 h-100 hover-shadow">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-chat-left-text fs-4" style="color: #6f42c1;"></i>
                                        <div class="fw-semibold">Platform Feedback</div>
                                    </div>
                                    <p class="small text-muted mb-0">Share feedback about the platform</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .card {
        border: 0;
    }

        .card .fw-semibold {
            font-size: 1.05rem;
        }

    .hover-shadow {
        transition: all 0.3s ease;
    }

        .hover-shadow:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }
</style>

@if (TempData["Success"] != null)
{
    <script>
        alert('@TempData["Success"]');
    </script>
}