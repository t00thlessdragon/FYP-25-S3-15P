@model FYP_25_S3_15P.ViewModels.UADashboardVm
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "University Admin Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Welcome, @Model.AdminName</h2>
            <p class="text-muted">@Model.UniversityName</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Users</h5>
                    <h2>@Model.TotalUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Total Programs</h5>
                    <h2>@Model.TotalPrograms</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Total Courses</h5>
                    <h2>@Model.TotalCourses</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Total Experts</h5>
                    <h2>@Model.TotalExperts</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Management Sections -->
    <div class="row">
        <!-- Manage Profile Section -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Manage Profile</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("ViewProfile", "UADashboard")" class="btn btn-outline-primary">View Profile</a>
                        <a href="@Url.Action("UpdateProfile", "UADashboard")" class="btn btn-outline-secondary">Update Profile</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Manage University Section -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Manage University</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("SetUniversityConstraints", "UADashboard")" class="btn btn-outline-success">Set University Constraints</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Manage Program Section -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Manage Program</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("ManageProgram", "UADashboard")" class="btn btn-outline-info">Manage Program</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Manage Course Section -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0">Manage Course</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("ManageCourse", "UADashboard")" class="btn btn-outline-warning">Manage Course</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Manage Users List Section -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Manage Users</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("ManageUsersList", "UADashboard")" class="btn btn-outline-danger">Manage Users List</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Manage Reports Section -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Manage Reports</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("ManageReports", "UADashboard")" class="btn btn-outline-secondary">Generate Reports</a>
                        <a href="@Url.Action("DownloadReports", "UADashboard")" class="btn btn-outline-secondary">Download Reports</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Manage Expertise Section -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Manage Expertise</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("ManageExpertise", "UADashboard")" class="btn btn-outline-dark">Manage Expertise</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Platform Feedback Section -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header" style="background-color: #6f42c1; color: white;">
                    <h5 class="mb-0">Platform Feedback</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("ProvideFeedback", "UADashboard")" class="btn btn-outline-dark">Provide Platform Feedback</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <script>
        alert('@TempData["Success"]');
    </script>
}
