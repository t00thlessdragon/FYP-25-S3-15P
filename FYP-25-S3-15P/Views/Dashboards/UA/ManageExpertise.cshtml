@model FYP_25_S3_15P.ViewModels.ExpertiseMasterVm
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Manage Expertise";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>Manage Expertise</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "UADashboard")">Dashboard</a></li>
                    <li class="breadcrumb-item active">Manage Expertise</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Expertise Table -->
    <div class="card">
        <div class="card-body">
            @if (Model.Experts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Staff Name</th>
                                <th>Email</th>
                                <th>Modules</th>
                                <th>Module Count</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expert in Model.Experts)
                            {
                                <tr>
                                    <td>@expert.StaffName</td>
                                    <td>@expert.Email</td>
                                    <td>@expert.Modules</td>
                                    <td><span class="badge bg-info">@expert.ModuleCount</span></td>
                                    <td>
                                        <a href="@Url.Action("ViewExpertise", "UADashboard", new { id = expert.ID })"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No staff expertise found.
                </div>
            }
        </div>
    </div>
</div>