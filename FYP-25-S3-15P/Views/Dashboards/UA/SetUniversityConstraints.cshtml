@model FYP_25_S3_15P.ViewModels.UniversityConstraintsVm
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "University Constraints";
    Layout = "_UADashboardLayout";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>University Constraints</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "UADashboard")">Dashboard</a></li>
                    <li class="breadcrumb-item active">University Constraints</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Constraints.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>PTeamSize</th>
                                <th>SLoadCap</th>
                                <th>ALoadCap</th>
                                <th>PrefRankLimit</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var constraint in Model.Constraints)
                            {
                                <tr>
                                    <td>@constraint.PTeamSize</td>
                                    <td>@constraint.SLoadCap</td>
                                    <td>@constraint.ALoadCap</td>
                                    <td>@constraint.PrefRankLimit</td>
                                    <td>
                                        <a href="@Url.Action("EditConstraint", "UADashboard", new { id = constraint.ID })"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No constraints configured.
                </div>
            }

            <div class="mt-3">
                <a href="@Url.Action("CreateConstraint", "UADashboard")" class="btn btn-primary">
                    Add New Constraint
                </a>
            </div>
        </div>
    </div>
</div>