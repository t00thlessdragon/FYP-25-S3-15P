@model FYP_25_S3_15P.ViewModels.ProgramMasterVm
@{
    ViewData["Title"] = "Manage Programs";
    Layout = "_UADashboardLayout";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid py-4">
    <h2 class="mb-3">Manage Programs</h2>

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="UADashboard" asp-action="Index">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Manage Programs</li>
        </ol>
    </nav>

    <!-- Search and Create Button (Always visible) -->
    <div class="row mb-4">
        <div class="col-md-8">
            <form method="get" asp-action="ManageProgram">
                <div class="input-group">
                    <input type="text" name="search" class="form-control"
                           placeholder="Search by program name or ID..."
                           value="@ViewBag.SearchQuery" />
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("CreateProgram", "UADashboard")" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create Program
            </a>
        </div>
    </div>

    @if (Model.Programs == null || !Model.Programs.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No programs found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Program ID</th>
                            <th>Program Name</th>
                            <th>Course Count</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var program in Model.Programs)
                        {
                            <tr>
                                <td>@program.ProgramID</td>
                                <td>@program.ProgramName</td>
                                <td>@program.CourseCount</td>
                                <td>
                                    <a href="@Url.Action("ViewProgram", "UADashboard", new { id = program.ID })"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                    <a href="@Url.Action("UpdateProgram", "UADashboard", new { id = program.ID })"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>