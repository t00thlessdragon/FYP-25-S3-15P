@model FYP_25_S3_15P.ViewModels.ExpertiseDetailVm
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Expertise Details";
    Layout = "_UADashboardLayout";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Staff Expertise Details</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "UADashboard")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ManageExpertise", "UADashboard")">Manage Expertise</a></li>
                    <li class="breadcrumb-item active">Expertise Details</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">@Model.StaffName</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Email:</strong>
                    <p>@Model.Email</p>
                </div>
                <div class="col-md-6">
                    <strong>Total Modules:</strong>
                    <p><span class="badge bg-info">@Model.Modules.Count</span></p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <strong>Module Expertise:</strong>
                    @if (Model.Modules.Any())
                    {
                        <table class="table table-sm table-bordered mt-2">
                            <thead class="table-light">
                                <tr>
                                    <th>Module Name</th>
                                    <th>Course</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var module in Model.Modules)
                                {
                                    <tr>
                                        <td>@module.ModuleName</td>
                                        <td>@module.CourseName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No modules assigned.</p>
                    }
                </div>
            </div>

            <hr>

            <div class="d-flex gap-2 flex-wrap">
                <a href="@Url.Action("UpdateExpertise", "UADashboard", new { id = Model.StaffProfileID })"
                   class="btn btn-warning">
                    Update Expertise
                </a>

                <a href="@Url.Action("CreateExpertise", "UADashboard")"
                   class="btn btn-success">
                    Create Expertise
                </a>

                <form method="post" asp-action="DeleteExpertise" asp-route-id="@Model.StaffProfileID"
                      onsubmit="return confirm('Are you sure you want to delete this expertise record?');" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        Delete Expertise
                    </button>
                </form>

                <button type="button" class="btn btn-secondary" onclick="document.getElementById('uploadForm').style.display='block'">
                    Upload Data File
                </button>

                <a href="@Url.Action("ManageExpertise", "UADashboard")" class="btn btn-secondary">
                    Back to List
                </a>
            </div>

            <!-- Upload Form (Hidden by default) -->
            <div id="uploadForm" style="display:none;" class="mt-3">
                <div class="card">
                    <div class="card-body">
                        <h6>Upload Expertise Data File</h6>
                        <form method="post" enctype="multipart/form-data" asp-action="UploadExpertiseData">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="staffId" value="@Model.StaffProfileID" />
                            <div class="mb-3">
                                <input type="file" name="file" class="form-control" accept=".csv,.xlsx" required />
                            </div>
                            <button type="submit" class="btn btn-primary">Upload</button>
                            <button type="button" class="btn btn-secondary" onclick="document.getElementById('uploadForm').style.display='none'">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>