@model FYP_25_S3_15P.ViewModels.CourseDetailVm
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Course Details";
    Layout = "_UADashboardLayout";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Course Details</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "UADashboard")">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ManageCourse", "UADashboard")">Manage Courses</a></li>
                    <li class="breadcrumb-item active">Course Details</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-warning text-white">
            <h5 class="mb-0">@Model.CourseName</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Course ID:</strong>
                    <p>@Model.CourseID</p>
                </div>
                <div class="col-md-6">
                    <strong>Program:</strong>
                    <p>@Model.ProgramName</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <strong>Description:</strong>
                    <p>@Model.Description</p>
                </div>
            </div>

            <hr>

            <div class="d-flex gap-2 flex-wrap">
                <a href="@Url.Action("UpdateCourse", "UADashboard", new { id = Model.ID })"
                   class="btn btn-warning">
                    Update Course
                </a>

                <a href="@Url.Action("CreateCourse", "UADashboard")"
                   class="btn btn-success">
                    Create Course
                </a>

                <form method="post" asp-action="DeleteCourse" asp-route-id="@Model.ID"
                      onsubmit="return confirm('Are you sure you want to delete this course?');" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        Delete Course
                    </button>
                </form>

                <button type="button" class="btn btn-secondary" onclick="document.getElementById('uploadForm').style.display='block'">
                    Upload Data File
                </button>

                <a href="@Url.Action("ManageCourse", "UADashboard")" class="btn btn-secondary">
                    Back to List
                </a>
            </div>

            <!-- Upload Form (Hidden by default) -->
            <div id="uploadForm" style="display:none;" class="mt-3">
                <div class="card">
                    <div class="card-body">
                        <h6>Upload Course Data File</h6>
                        <form method="post" enctype="multipart/form-data" asp-action="UploadCourseData">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@Model.ID" />
                            <div class="mb-3">
                                <input type="file" name="file" class="form-control" accept=".csv,.xlsx" required />
                            </div>
                            <button type="submit" class="btn btn-primary">Upload</button>
                            <button type="button" class="btn btn-secondary" onclick="document.getElementById('uploadForm').style.display='none'">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>