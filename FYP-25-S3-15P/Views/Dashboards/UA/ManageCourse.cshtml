@model FYP_25_S3_15P.ViewModels.CourseMasterVm
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Manage Courses";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>Manage Courses</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "UADashboard")">Dashboard</a></li>
                    <li class="breadcrumb-item active">Manage Courses</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Courses Table -->
    <div class="card">
        <div class="card-body">
            @if (Model.Courses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Course ID</th>
                                <th>Course Name</th>
                                <th>Description</th>
                                <th>Program</th>
                                <th>Modules</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model.Courses)
                            {
                                <tr>
                                    <td>@course.CourseID</td>
                                    <td>@course.CourseName</td>
                                    <td>@course.Description</td>
                                    <td>@course.ProgramName</td>
                                    <td><span class="badge bg-info">@course.ModuleCount</span></td>
                                    <td>
                                        <a href="@Url.Action("ViewCourse", "UADashboard", new { id = course.ID })"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No courses found.
                </div>
            }
        </div>
    </div>
</div>