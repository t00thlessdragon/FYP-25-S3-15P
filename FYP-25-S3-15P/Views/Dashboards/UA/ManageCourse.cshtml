@model FYP_25_S3_15P.ViewModels.CourseMasterVm
@{
    ViewData["Title"] = "Manage Courses";
    Layout = "_UADashboardLayout";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid py-4">
    <h2 class="mb-3">Manage Courses</h2>

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="UADashboard" asp-action="Index">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Manage Courses</li>
        </ol>
    </nav>

    <!-- Search and Create Button -->
    <div class="row mb-4">
        <div class="col-md-8">
            <form method="get" asp-action="ManageCourse">
                <div class="input-group">
                    <input type="text" name="search" class="form-control"
                           placeholder="Search by course name or ID..."
                           value="@ViewBag.SearchQuery" />
                    <button type="submit" class="btn btn-outline-secondary">
                        Search
                    </button>
                </div>
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("CreateCourse", "UADashboard")" class="btn btn-primary">
                Create Course
            </a>
        </div>
    </div>

    @if (Model.Courses == null || !Model.Courses.Any())
    {
        <div class="alert alert-info">
            No courses found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Course ID</th>
                            <th>Course Name</th>
                            <th>Program</th>
                            <th>Modules</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td>@course.CourseID</td>
                                <td>@course.CourseName</td>
                                <td>@course.ProgramName</td>
                                <td>@course.ModuleCount</td>
                                <td>
                                    <a href="@Url.Action("ViewCourse", "UADashboard", new { id = course.ID })"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                    <a href="@Url.Action("UpdateCourse", "UADashboard", new { id = course.ID })"
                                       class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>