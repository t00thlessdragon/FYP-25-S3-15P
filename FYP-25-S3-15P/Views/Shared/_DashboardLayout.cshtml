@* Views/Shared/_DashboardLayout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] SMART Dashboard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-nav fixed-top shadow-sm">
        <div class="container-wide nav-grid">
            <!-- Brand -->
            <a class="navbar-brand p-0 me-3" asp-controller="Home" asp-action="Index">
                <img src="~/images/smartlogo.png" alt="SMART" class="brand-logo" />
            </a>

            <!-- Toggler (mobile) -->
            <button class="navbar-toggler d-lg-none ms-auto" type="button"
                    data-bs-toggle="collapse" data-bs-target="#dashNav"
                    aria-controls="dashNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Center Menu (Desktop) -->
            <ul class="navbar-nav nav-center d-none d-lg-flex">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Main Site</a>
                </li>

                @* PLATFORM ADMIN LINKS *@
                @if (User.IsInRole("Platform Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="PADashboard" asp-action="ContentMaster">Content Master</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="PADashboard" asp-action="UserMaster">User Master</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="PADashboard" asp-action="ApplicationMaster">Application Master</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="PADashboard" asp-action="Reports">System Reports</a></li>
                }
                @* UNIVERSITY ADMIN LINKS *@
                else if (User.IsInRole("University Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="UniversityMaster">Manage University</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageProgram">Manage Program</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageCourse">Manage Course</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageUser">Manage User</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageExpertise">Manage Expertise</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageReport">Manage Report</a></li>
                }
            </ul>

            <!-- Right (Desktop): User Dropdown -->
            <div class="d-none d-lg-flex align-items-center ms-3">
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    var displayName = User.Identity?.Name ?? "User";
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Welcome, @displayName
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><a class="dropdown-item" href="mailto:noreply.smartproject@gmail.com">Contact Support</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link text-danger p-0">
                                        <i class="bi bi-power"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>

            <!-- Mobile Collapse Menu -->
            <div class="collapse d-lg-none mt-2" id="dashNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Main Site</a></li>

                    @if (User.IsInRole("PlatformAdmin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="PADashboard" asp-action="ContentMaster">Content Master</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PADashboard" asp-action="UserMaster">User Master</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PADashboard" asp-action="ApplicationMaster">Application Master</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PADashboard" asp-action="Reports">System Reports</a></li>
                    }
                    else if (User.IsInRole("UniversityAdmin"))
                    {
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="UniversityMaster">Manage University</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageProgram">Manage Program</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageCourse">Manage Course</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageUser">Manage User</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageExpertise">Manage Expertise</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="UADashboard" asp-action="ManageReport">Manage Report</a></li>
                    }

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <li><hr class="dropdown-divider" /></li>
                        <li class="nav-item px-2 text-muted">Welcome, @User.Identity!.Name</li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 my-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-power"></i> Logout
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Body -->
    <main class="pt-nav">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="~/js/choices.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/features-admin.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
